# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# Put your real values (DATABASE_URL, APP_SECRET, OAuth…) in .env.local
# or in the secrets vault: https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
# Generate one with: php -r "echo bin2hex(random_bytes(16)).PHP_EOL;"
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
# Used to generate absolute URLs in CLI commands (e.g. email links).
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Adjust user, password, host, db name and server version to your setup.
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/librebooking?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Use "sync://" to process messages synchronously (no worker needed) in dev.
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###

###> symfony/mailer ###
# Examples: smtp://user:pass@smtp.example.com:587  or  null://null to disable sending.
MAILER_DSN=null://null
# Expéditeur des e-mails (requis : utilisé par PrestaNotifier et les notifications de réservation)
MAILER_FROM_ADDRESS=no-reply@example.com
MAILER_FROM_NAME=Librebooking
###< symfony/mailer ###

###> Google OAuth2 SSO (KnpUOAuth2ClientBundle) ###
# Create credentials at https://console.cloud.google.com/apis/credentials
# Leave empty if you only use email/password authentication.
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=
###< Google OAuth2 SSO ###
