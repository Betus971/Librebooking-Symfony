{#
 #  Rendu de pagination unique du projet (KnpPaginatorBundle) — DaisyUI 5.
 #  Référencé par config/packages/knp_paginator.yaml et ManualPaginationTrait.
 #
 #  Variables KnpPaginator : pageCount, current, first, last, previous, next,
 #  pagesInRange, route, query, options.
 #}
{% if pageCount > 1 %}
    <nav class="flex justify-center my-6" aria-label="Pagination">
        <div class="join">
            {% if previous is defined %}
                <a class="join-item btn btn-sm" rel="prev" href="{{ path(route, knp_pagination_query(query, previous, options)) }}" aria-label="Page précédente">«</a>
            {% else %}
                <span class="join-item btn btn-sm btn-disabled" aria-disabled="true">«</span>
            {% endif %}

            {% if first is defined and first not in pagesInRange %}
                <a class="join-item btn btn-sm" href="{{ path(route, knp_pagination_query(query, first, options)) }}">{{ first }}</a>
                {% if first + 1 not in pagesInRange %}<span class="join-item btn btn-sm btn-disabled">…</span>{% endif %}
            {% endif %}

            {% for page in pagesInRange %}
                {% if page == current %}
                    <span class="join-item btn btn-sm btn-primary" aria-current="page">{{ page }}</span>
                {% else %}
                    <a class="join-item btn btn-sm" href="{{ path(route, knp_pagination_query(query, page, options)) }}">{{ page }}</a>
                {% endif %}
            {% endfor %}

            {% if last is defined and last not in pagesInRange %}
                {% if last - 1 not in pagesInRange %}<span class="join-item btn btn-sm btn-disabled">…</span>{% endif %}
                <a class="join-item btn btn-sm" href="{{ path(route, knp_pagination_query(query, last, options)) }}">{{ last }}</a>
            {% endif %}

            {% if next is defined %}
                <a class="join-item btn btn-sm" rel="next" href="{{ path(route, knp_pagination_query(query, next, options)) }}" aria-label="Page suivante">»</a>
            {% else %}
                <span class="join-item btn btn-sm btn-disabled" aria-disabled="true">»</span>
            {% endif %}
        </div>
    </nav>
{% endif %}
