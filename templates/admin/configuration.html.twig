{% extends 'base.html.twig' %}

{% block title %}Configuration — Administration{% endblock %}

{% set sectionLabels = {
    'general':     'Général',
    'reservation': 'Réservations',
    'mail':        'E-mails',
    'modules':     'Modules'
} %}

{% block body %}
<div class="max-w-4xl mx-auto py-8">
    <div class="mb-6">
        <h1 class="text-3xl font-extrabold text-base-content">Configuration de l'application</h1>
        <p class="text-sm text-base-content/60 mt-1">Réglages modifiables sans redéploiement. Les valeurs par défaut s'appliquent tant que rien n'est saisi.</p>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success shadow-sm mb-6">
            <svg class="h-6 w-6 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <span>{{ message }}</span>
        </div>
    {% endfor %}

    {{ form_start(form) }}
    <div class="space-y-6">
        {% for section, cles in sections %}
            <div class="card bg-base-100 border border-base-200 shadow-sm">
                <div class="card-body p-6">
                    <h2 class="text-lg font-bold text-primary mb-4">{{ sectionLabels[section] ?? section|capitalize }}</h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
                        {% for cle in cles %}
                            {% set field = form[cle] %}
                            {% set isCheckbox = 'checkbox' in field.vars.block_prefixes %}
                            <div class="form-control {{ isCheckbox ? 'sm:col-span-2' : '' }}">
                                {% if isCheckbox %}
                                    <label class="label cursor-pointer justify-start gap-3">
                                        {{ form_widget(field, {'attr': {'class': 'toggle toggle-primary'}}) }}
                                        <span class="label-text font-medium">{{ field.vars.label }}</span>
                                    </label>
                                {% else %}
                                    {{ form_label(field, null, {'label_attr': {'class': 'label font-medium text-base-content'}}) }}
                                    {{ form_widget(field, {'attr': {'class': 'input input-bordered w-full'}}) }}
                                {% endif %}
                                {% if field.vars.errors|length > 0 %}
                                    <label class="label"><span class="label-text-alt text-error">{{ form_errors(field) }}</span></label>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="mt-6 flex justify-end gap-3">
        <a href="{{ path('admin') }}" class="btn btn-ghost">Retour à l'admin</a>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
