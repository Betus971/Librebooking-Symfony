{% extends 'base.html.twig' %}

{% block title %}Réservations — Administration{% endblock %}

{% macro badge(s) %}
    {% if s == 1 %}<span class="badge badge-warning badge-sm">En attente</span>
    {% elseif s == 2 %}<span class="badge badge-success badge-sm">Approuvée</span>
    {% elseif s == 3 %}<span class="badge badge-error badge-sm">Refusée</span>
    {% elseif s == 4 %}<span class="badge badge-ghost badge-sm">Annulée</span>
    {% else %}<span class="badge badge-sm">Inconnu</span>{% endif %}
{% endmacro %}
{% import _self as ui %}

{% block body %}
<div class="max-w-7xl mx-auto py-8">
    <div class="flex items-center justify-between mb-6 gap-3 flex-wrap">
        <div>
            <h1 class="text-3xl font-extrabold text-base-content">Toutes les réservations</h1>
            <p class="text-sm text-base-content/60 mt-1">{{ total }} dossier(s) trouvé(s)</p>
        </div>
        <a href="{{ path('admin_reservation_pending') }}" class="btn btn-outline btn-sm gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Demandes en attente
        </a>
    </div>

    <form method="get" action="{{ path('admin_reservation_index') }}" class="card bg-base-100 border border-base-200 shadow-sm mb-6">
        <div class="card-body p-4 grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
            <div class="form-control md:col-span-3">
                <label class="label py-1" for="q"><span class="label-text">Recherche (titre / demandeur)</span></label>
                <input class="input input-bordered input-sm w-full" id="q" name="q" type="text" value="{{ filters.q }}" placeholder="Ex : Réunion...">
            </div>
            <div class="form-control md:col-span-3">
                <label class="label py-1" for="resource"><span class="label-text">Ressource</span></label>
                <select class="select select-bordered select-sm w-full" id="resource" name="resource">
                    <option value="">Toutes les ressources</option>
                    {% for res in resources %}
                        <option value="{{ res.id }}" {{ filters.resource == res.id ? 'selected' }}>{{ res.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-control md:col-span-2">
                <label class="label py-1" for="status"><span class="label-text">Statut</span></label>
                <select class="select select-bordered select-sm w-full" id="status" name="status">
                    <option value="">Tous</option>
                    <option value="1" {{ filters.status == 1 ? 'selected' }}>En attente</option>
                    <option value="2" {{ filters.status == 2 ? 'selected' }}>Approuvée</option>
                    <option value="3" {{ filters.status == 3 ? 'selected' }}>Refusée</option>
                    <option value="4" {{ filters.status == 4 ? 'selected' }}>Annulée</option>
                </select>
            </div>
            <div class="form-control md:col-span-2">
                <label class="label py-1" for="from"><span class="label-text">Du</span></label>
                <input class="input input-bordered input-sm w-full" id="from" name="from" type="date" value="{{ filters.from ? filters.from|date('Y-m-d') }}">
            </div>
            <div class="form-control md:col-span-2">
                <label class="label py-1" for="to"><span class="label-text">Au</span></label>
                <input class="input input-bordered input-sm w-full" id="to" name="to" type="date" value="{{ filters.to ? filters.to|date('Y-m-d') }}">
            </div>
            <div class="md:col-span-12 flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm">Filtrer</button>
                <a href="{{ path('admin_reservation_index') }}" class="btn btn-ghost btn-sm">Réinitialiser</a>
            </div>
        </div>
    </form>

    <div class="overflow-x-auto card bg-base-100 border border-base-200 shadow-sm">
        <table class="table table-zebra">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Demandeur</th>
                    <th class="text-right">Dates</th>
                    <th>Statut</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for r in rows %}
                <tr class="hover">
                    <td>
                        <span class="font-bold" title="{{ r.title }}">{{ r.title|length > 40 ? r.title|slice(0, 40) ~ '...' : r.title }}</span>
                        {% if r.resCount > 0 %}<br><span class="text-xs text-base-content/50">{{ r.oneName }}{{ r.resCount > 1 ? ' (+' ~ (r.resCount - 1) ~ ')' : '' }}</span>{% endif %}
                    </td>
                    <td>{% set owner = r.ownerName ?: 'Inconnu' %}<span title="{{ owner }}">{{ owner|length > 35 ? owner|slice(0, 35) ~ '...' : owner }}</span></td>
                    <td class="text-right text-sm">
                        {{ r.firstStart ? r.firstStart|date('d/m/Y H:i') : '-' }}<br>
                        <span class="text-base-content/60">au {{ r.lastEnd ? r.lastEnd|date('d/m/Y H:i') : '-' }}</span>
                    </td>
                    <td>{{ ui.badge(r.statusId) }}</td>
                    <td class="text-right">
                        <a href="{{ path('admin_reservation_show', {id: r.id}) }}" class="btn btn-ghost btn-xs text-primary">Voir</a>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-center py-8 text-base-content/60">Aucune réservation.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="mt-4 flex justify-center">{{ knp_pagination_render(pagination) }}</div>
</div>
{% endblock %}
