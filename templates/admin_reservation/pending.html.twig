{% extends 'base.html.twig' %}

{% block body %}

    <div class="fr-container fr-my-6w">
        <h1 class="fr-h3 fr-mb-3w">Demandes en attente</h1>

        {# --- FILTRES --- #}
        <form method="get" action="{{ path('admin_reservation_pending') }}" class="fr-grid-row fr-grid-row--gutters fr-mb-3w fr-background-alt--blue-france fr-p-2w">
            {# Recherche texte #}
            <div class="fr-col-12 fr-col-md-3">
                <label class="fr-label" for="q">Recherche (titre/nom)</label>
                <input class="fr-input" id="q" name="q" type="text" value="{{ filters.q }}" placeholder="Ex: Réunion...">
            </div>

            {# Select Ressource #}
            <div class="fr-col-12 fr-col-md-3">
                <label class="fr-label" for="resource">Ressource</label>
                <select class="fr-select" id="resource" name="resource">
                    <option value="">Toutes les ressources</option>
                    {% for res in resources %}
                        <option value="{{ res.id }}" {{ filters.resource == res.id ? 'selected' }}>
                            {{ res.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            {# Dates #}
            <div class="fr-col-6 fr-col-md-2">
                <label class="fr-label" for="from">Du</label>
                <input class="fr-input" id="from" name="from" type="date" value="{{ filters.from ? filters.from|date('Y-m-d') }}">
            </div>
            <div class="fr-col-6 fr-col-md-2">
                <label class="fr-label" for="to">Au</label>
                <input class="fr-input" id="to" name="to" type="date" value="{{ filters.to ? filters.to|date('Y-m-d') }}">
            </div>

            {# Bouton Filtrer #}
            <div class="fr-col-12 fr-col-md-2 fr-display-flex fr-align-items-end">
                <button type="submit" class="fr-btn fr-btn--icon-left fr-icon-search-line fr-btn--wide">Filtrer</button>
            </div>

            {# Filtres radio (Approbation) #}
            <div class="fr-col-12 fr-mt-2w">
                <fieldset class="fr-fieldset fr-m-0">
                    <legend class="fr-fieldset__legend fr-text--regular fr-mb-1w">Type de demande :</legend>
                    <div class="fr-fieldset__content fr-display-flex fr-gap-2w">
                        <div class="fr-radio-group">
                            <input type="radio" id="appr-all" name="approval" value="all" {{ filters.approval == 'all' ? 'checked' }}>
                            <label class="fr-label" for="appr-all">Tout</label>
                        </div>
                        <div class="fr-radio-group">
                            <input type="radio" id="appr-req" name="approval" value="req" {{ filters.approval == 'req' ? 'checked' }}>
                            <label class="fr-label" for="appr-req">Approbation requise</label>
                        </div>
                        <div class="fr-radio-group">
                            <input type="radio" id="appr-noreq" name="approval" value="noreq" {{ filters.approval == 'noreq' ? 'checked' }}>
                            <label class="fr-label" for="appr-noreq">Auto-approuvée</label>
                        </div>
                    </div>
                </fieldset>
            </div>
        </form>

        {# --- TABLEAU --- #}
        <div class="fr-table fr-table--bordered fr-table--layout-fixed">
            <div class="fr-table__wrapper">
                <div class="fr-table__container">
                    <div class="fr-table__content">
                        <table>
                            <caption>Liste des réservations ({{ total }} résultats)</caption>
                            <thead>
                            <tr>
                                <th scope="col" style="width: 20%;">Titre</th>
                                <th scope="col">Demandeur</th>
                                <th scope="col">Ressource(s)</th>
                                <th scope="col" class="fr-text--right">Créée le</th>
                                <th scope="col" class="fr-text--right">Créneau</th>
                                <th scope="col">Statut</th>
                                <th scope="col" class="fr-text--right">Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% set nowTs = "now"|date('U') %}

                            {% for r in rows %}
                                {% set lastEndTs = r.lastEnd ? r.lastEnd|date('U') : 0 %}
                                {% set isPast = lastEndTs <= nowTs %}
                                {% set resourceName = (r.resCount|default(0)) > 1 ? (r.resCount ~ ' ressources') : (r.oneName|default('—')) %}

                                <tr id="serie-{{ r.id }}" {% if r.statusId == 1 %}style="background-color: var(--background-contrast-warning);"{% endif %}>
                                    <td>
                                        <a href="{{ path('admin_reservation_show', { id: r.id }) }}" class="fr-text--bold fr-link">
                                            {{ r.title }}
                                        </a>
                                        {% if r.attachmentCount is defined and r.attachmentCount > 0 %}
                                            <br><span class="fr-badge fr-badge--sm fr-badge--no-icon fr-badge--info fr-mt-1v">
                                                <span class="fr-icon-attachment-line fr-icon--sm" aria-hidden="true"></span>
                                                {{ r.attachmentCount }} pièce(s) jointe(s)
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="fr-badge fr-badge--no-icon fr-badge--sm fr-badge--purple-glycine">
                                            {{ r.ownerName ?: 'Inconnu' }}
                                        </span>
                                    </td>
                                   <td>{{ resourceName }}</td>


                                    <td class="fr-text--right">
                                        {{ r.createdAt ? r.createdAt|date('d/m/Y') : '-' }}<br>
                                        <span class="fr-text--xs fr-text--mention-grey">{{ r.createdAt ? r.createdAt|date('H:i') : '' }}</span>
                                    </td>
                                    <td class="fr-text--right">
                                        <span class="fr-text--bold">{{ r.firstStart ? r.firstStart|date('d/m/Y') : '-' }}</span><br>
                                        <span class="fr-text--xs">
                                            {{ r.firstStart ? r.firstStart|date('H:i') : '' }} - {{ r.lastEnd ? r.lastEnd|date('H:i') : '' }}
                                        </span>
                                    </td>
                                    <td>
                                        {% set status = r.statusId|default(1) %}
                                        {% if status == 1 %}
                                            <p class="fr-badge fr-badge--warning fr-badge--sm">En attente</p>
                                        {% elseif status == 2 %}
                                            <p class="fr-badge fr-badge--success fr-badge--sm">Approuvée</p>
                                        {% elseif status == 3 %}
                                            <p class="fr-badge fr-badge--error fr-badge--sm">Refusée</p>
                                        {% elseif status == 4 %}
                                            <p class="fr-badge fr-badge--info fr-badge--sm">Annulée</p>
                                        {% else %}
                                            <p class="fr-badge fr-badge--sm">Inconnu</p>
                                        {% endif %}
                                    </td>
                                    <td class="fr-cell--right">
                                        {% if isPast %}
                                            <span class="fr-badge fr-badge--sm fr-badge--grey">Date passée</span>
                                        {% else %}
                                            <ul class="fr-btns-group fr-btns-group--inline fr-btns-group--sm fr-btns-group--right fr-mb-0">

                                                {# 1. BOUTON ACCEPTER DIRECT #}
                                                <li>
                                                    <form method="post" action="{{ path('admin_reservation_approve', { id: r.id }) }}" style="margin: 0;">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ r.id) }}">
                                                        <button type="submit" class="fr-btn fr-btn--success fr-btn--sm fr-icon-check-line" title="Approuver directement">
                                                            Valider
                                                        </button>
                                                    </form>
                                                </li>

                                                {# 2. BOUTON REFUSER (Ouvre la modale) #}
                                                <li>
                                                    <button class="fr-btn fr-btn--secondary fr-btn--sm fr-icon-close-circle-line"
                                                            aria-controls="modal-actions-{{ r.id }}"
                                                            data-fr-opened="false"
                                                            title="Refuser avec motif">
                                                        Refuser
                                                    </button>
                                                </li>

                                            </ul>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="7" class="fr-text--center fr-py-3w">
                                        Aucune réservation trouvée avec ces filtres.
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        {# --- MODALES D'ACTIONS (Hors du tableau pour éviter les soucis de z-index) --- #}
        {% for r in rows %}
            <dialog id="modal-actions-{{ r.id }}" class="fr-modal" role="dialog" aria-labelledby="modal-title-{{ r.id }}">
                <div class="fr-container fr-container--fluid fr-container-md">
                    <div class="fr-grid-row fr-grid-row--center">
                        <div class="fr-col-12 fr-col-md-8 fr-col-lg-6">
                            <div class="fr-modal__body">
                                <div class="fr-modal__header">
                                    <button class="fr-btn--close fr-btn" aria-controls="modal-actions-{{ r.id }}">Fermer</button>
                                </div>
                                <div class="fr-modal__content">
                                    <h1 id="modal-title-{{ r.id }}" class="fr-modal__title">
                                        Refuser la demande de {{ r.ownerName }}
                                    </h1>
                                    <p class="fr-text--sm fr-mb-4w">
                                        Réservation pour : <strong>{{ r.title }}</strong><br>
                                        Date : {{ r.firstStart|date('d/m/Y') }} de {{ r.firstStart|date('H:i') }} à {{ r.lastEnd|date('H:i') }}
                                    </p>

                                    {# ACTION: REFUSER (AVEC MOTIF) #}
                                    <div class="fr-highlight fr-highlight--orange-terre-battue fr-ml-0 fr-mb-4w">
                                        <form method="post" action="{{ path('admin_reservation_reject', { id: r.id }) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ r.id) }}">

                                            <div class="fr-input-group">
                                                <label class="fr-label" for="reason-{{ r.id }}">Motif du refus (obligatoire)</label>
                                                <textarea class="fr-input" id="reason-{{ r.id }}" name="reason" rows="3" required placeholder="Ex: Salle indisponible pour cause de travaux..."></textarea>
                                            </div>

                                            <button type="submit" class="fr-btn fr-icon-close-circle-line fr-btn--icon-left">
                                                Confirmer le refus
                                            </button>
                                        </form>
                                    </div>

                                    {# ACTION: ANNULER (FORCE ADMINISTRATIVE) #}
                                    <div class="fr-mt-4w fr-pt-2w" style="border-top: 1px solid var(--border-default-grey);">
                                        <form method="post" action="{{ path('admin_reservation_cancel', { id: r.id }) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir annuler de force cette demande ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ r.id) }}">
                                            <p class="fr-text--sm fr-mb-1w">En cas de bug ou problème technique :</p>
                                            <button type="submit" class="fr-btn fr-btn--tertiary fr-btn--sm fr-icon-delete-line fr-btn--icon-left" style="color: var(--text-default-error);">
                                                Forcer l'annulation
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </dialog>
        {% endfor %}

        {# --- PAGINATION (rendu DSFR unifié via KnpPaginator) --- #}
        <div class="fr-mt-3w">
            {{ knp_pagination_render(pagination) }}
        </div>
    </div>

    <script>


        document.querySelectorAll('[aria-controls^="modal-actions-"]').forEach(button => {
            button.addEventListener('click', (e) => {
                const modalId = e.target.getAttribute('aria-controls');
                const modal = document.getElementById(modalId);
                modal.showModal();
            });
        });

        document.querySelectorAll('[data-fr-opened="false"]').forEach(button => {
            button.addEventListener('click', (e) => {
                if (e.target.getAttribute('aria-controls')) {
                    const modalId = e.target.getAttribute('aria-controls');
                    const modal = document.getElementById(modalId);
                    modal.close();
                }
            });
        });
    </script>

{% endblock %}
