{% extends 'base.html.twig' %}
{% block title %}Détail réservation — Administration{% endblock %}
{% block body %}
<div class="max-w-6xl mx-auto py-8">
    <div class="mb-6">
        <a href="{{ path('admin_reservation_pending') }}" class="btn btn-ghost btn-sm gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            Retour aux demandes
        </a>
    </div>

    <div class="lg:grid lg:grid-cols-3 lg:gap-8">
        <div class="lg:col-span-2 space-y-6">
            <div>
                <h1 class="text-3xl font-extrabold mb-3">{{ series.title }}</h1>
                {% set sid = series.status.id %}
                {% if sid == 1 %}<span class="badge badge-warning badge-lg">En attente</span>
                {% elseif sid == 2 %}<span class="badge badge-success badge-lg">Approuvée</span>
                {% elseif sid == 3 %}<span class="badge badge-error badge-lg">Refusée</span>
                {% elseif sid == 4 %}<span class="badge badge-ghost badge-lg">Annulée</span>{% endif %}
            </div>

            {% if series.description %}
                <div class="alert bg-base-200 border-l-4 border-l-primary rounded-none rounded-r-box"><p class="whitespace-pre-wrap">{{ series.description }}</p></div>
            {% endif %}

            <div>
                <h2 class="text-xl font-bold mb-3">Créneaux</h2>
                <div class="overflow-x-auto card bg-base-100 border border-base-200 shadow-sm">
                    <table class="table table-zebra">
                        <thead><tr><th>Date</th><th>Horaire</th><th>Référence</th></tr></thead>
                        <tbody>
                        {% for instance in series.instances %}
                            <tr>
                                <td class="font-medium capitalize">{{ instance.startDate|format_datetime(locale=app.request.locale, pattern='EEEE d MMMM y') }}</td>
                                <td>{{ instance.startDate|date('H:i') }} – {{ instance.endDate|date('H:i') }}</td>
                                <td class="text-sm text-base-content/60 font-mono">{{ instance.referenceNumber }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="3" class="text-center py-6 text-base-content/50">Aucune date.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <div>
                <h2 class="text-xl font-bold mb-3">Pièces jointes <span class="badge badge-info badge-sm">{{ series.reservationAttachments|length }}</span></h2>
                {% if series.reservationAttachments is not empty %}
                    <div class="overflow-x-auto card bg-base-100 border border-base-200 shadow-sm">
                        <table class="table">
                            <thead><tr><th>Fichier</th><th>Type</th><th>Taille</th><th class="text-right">Action</th></tr></thead>
                            <tbody>
                            {% for att in series.reservationAttachments %}
                                <tr>
                                    <td>{{ att.originalName }}</td>
                                    <td class="text-sm text-base-content/60">{{ att.mimeType }}</td>
                                    <td class="text-sm">{{ att.size ? (att.size / 1024)|round ~ ' Ko' : '—' }}</td>
                                    <td class="text-right"><a href="{{ path('admin_reservation_attachment_download', {id: att.id}) }}" class="btn btn-outline btn-xs">Télécharger</a></td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-sm text-base-content/60">Aucune pièce jointe.</p>
                {% endif %}
            </div>
        </div>

        <div class="mt-6 lg:mt-0">
            <div class="card bg-base-100 border border-base-200 shadow-xl sticky top-8">
                <div class="card-body p-6 space-y-4">
                    <div>
                        <h3 class="font-bold text-primary mb-2">Demandeur</h3>
                        {% if series.owner %}
                            <p class="text-sm"><span class="font-medium">Nom :</span> {{ series.owner.fname|capitalize }} {{ series.owner.lname|upper }}</p>
                            <p class="text-sm"><span class="font-medium">Email :</span> <a href="mailto:{{ series.owner.email }}" class="link link-primary break-all">{{ series.owner.email }}</a></p>
                        {% endif %}
                    </div>
                    <div class="divider my-1"></div>
                    <div>
                        <h3 class="font-bold text-primary mb-2">Ressource(s)</h3>
                        <div class="flex flex-wrap gap-2">
                            {% for link in series.reservationResources %}<span class="badge badge-outline">{{ link.resource.name }}</span>{% endfor %}
                        </div>
                    </div>
                    <div class="divider my-1"></div>
                    <div>
                        <h3 class="font-bold text-primary mb-3">Actions</h3>
                        {% if series.status.id == 1 %}
                            <form method="post" action="{{ path('admin_reservation_approve', {id: series.id}) }}" class="mb-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ series.id) }}">
                                <button class="btn btn-success w-full">Approuver</button>
                            </form>
                            <button type="button" class="btn btn-outline btn-error w-full" onclick="document.getElementById('modal-reject').showModal()">Refuser</button>
                        {% endif %}
                        {% if series.status.id in [1, 2] %}
                            <form method="post" action="{{ path('admin_reservation_cancel', {id: series.id}) }}" class="mt-2" onsubmit="return confirm('Annuler cette réservation ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ series.id) }}">
                                <button class="btn btn-ghost btn-sm w-full text-error">Annuler la réservation</button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% if series.status.id == 1 %}
<dialog id="modal-reject" class="modal">
    <div class="modal-box">
        <h3 class="font-bold text-lg mb-3">Motif du refus</h3>
        <form method="post" action="{{ path('admin_reservation_reject', {id: series.id}) }}" class="space-y-3">
            <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ series.id) }}">
            <textarea class="textarea textarea-bordered w-full" name="reason" rows="3" required placeholder="Raison (obligatoire)"></textarea>
            <div class="flex justify-end gap-2">
                <button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('modal-reject').close()">Annuler</button>
                <button type="submit" class="btn btn-error btn-sm">Confirmer le refus</button>
            </div>
        </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>
{% endif %}
{% endblock %}
