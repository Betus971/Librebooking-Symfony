{% extends 'base.html.twig' %}
{% block title %}Détail réservation — Admin{% endblock %}
{% block body %}
<div class="fr-container fr-mt-4w fr-mb-8w">

    <div class="fr-mb-3w">
        <a href="{{ path('admin_reservation_pending') }}" class="fr-link fr-icon-arrow-left-line fr-link--icon-left">
            Retour aux demandes
        </a>
    </div>

    <div class="fr-grid-row fr-grid-row--gutters">

        {# === COLONNE GAUCHE === #}
        <div class="fr-col-12 fr-col-md-8">
            <h1 class="fr-h2 fr-mb-1w">{{ series.title }}</h1>

            {# Statut #}
            <div class="fr-mb-3w">
                {% set sid = series.status.id %}
                {% if sid == 1 %}<span class="fr-badge fr-badge--warning">En attente</span>
                {% elseif sid == 2 %}<span class="fr-badge fr-badge--success">Approuvée</span>
                {% elseif sid == 3 %}<span class="fr-badge fr-badge--error">Refusée</span>
                {% elseif sid == 4 %}<span class="fr-badge fr-badge--info">Annulée</span>
                {% endif %}
            </div>

            {# Description #}
            {% if series.description %}
                <div class="fr-highlight fr-mb-3w">
                    <p class="fr-mb-0">{{ series.description|nl2br }}</p>
                </div>
            {% endif %}

            {# Créneaux #}
            <h2 class="fr-h4 fr-mt-4w">Créneaux</h2>
            <div class="fr-table fr-table--bordered">
                <table>
                    <thead><tr>
                        <th scope="col">Date</th>
                        <th scope="col">Horaire</th>
                        <th scope="col">Référence</th>
                    </tr></thead>
                    <tbody>
                    {% for instance in series.instances %}
                        <tr>
                            <td>{{ instance.startDate|format_datetime(locale='fr', pattern='EEEE d MMMM y')|capitalize }}</td>
                            <td>{{ instance.startDate|date('H:i') }} – {{ instance.endDate|date('H:i') }}</td>
                            <td class="fr-text--sm fr-text--mention-grey">{{ instance.referenceNumber }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="3" class="fr-text--center">Aucune date.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            {# === PIÈCES JOINTES === #}
            <h2 class="fr-h4 fr-mt-4w fr-mb-2w">
                <span class="fr-icon-attachment-line fr-icon--sm fr-mr-1v" aria-hidden="true"></span>
                Pièces jointes
                <span class="fr-badge fr-badge--sm fr-badge--info fr-ml-1w">{{ series.reservationAttachments|length }}</span>
            </h2>

            {% if series.reservationAttachments is not empty %}
                <div class="fr-table fr-table--bordered">
                    <table>
                        <thead><tr>
                            <th scope="col">Nom du fichier</th>
                            <th scope="col">Type</th>
                            <th scope="col">Taille</th>
                            <th scope="col">Action</th>
                        </tr></thead>
                        <tbody>
                        {% for att in series.reservationAttachments %}
                            <tr>
                                <td>
                                    <span class="fr-icon-file-line fr-icon--sm fr-mr-1v" aria-hidden="true"></span>
                                    {{ att.originalName }}
                                </td>
                                <td class="fr-text--sm fr-text--mention-grey">{{ att.mimeType }}</td>
                                <td class="fr-text--sm">
                                    {% if att.size %}
                                        {{ (att.size / 1024)|round }} Ko
                                    {% else %}—{% endif %}
                                </td>
                                <td>
                                    <a href="{{ path('admin_reservation_attachment_download', { id: att.id }) }}"
                                       class="fr-btn fr-btn--sm fr-btn--secondary fr-icon-download-line fr-btn--icon-left">
                                        Télécharger
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="fr-text--sm fr-text--mention-grey">Aucune pièce jointe pour cette réservation.</p>
            {% endif %}
        </div>

        {# === COLONNE DROITE === #}
        <div class="fr-col-12 fr-col-md-4">
            <div class="fr-card fr-card--no-border fr-card--shadow fr-p-3w">

                <h3 class="fr-h5 fr-mb-2w">Demandeur</h3>
                {% if series.owner %}
                    <p class="fr-text--sm fr-mb-1v"><strong>Nom :</strong> {{ series.owner.fname }} {{ series.owner.lname }}</p>
                    <p class="fr-text--sm fr-mb-1v"><strong>Email :</strong> <a href="mailto:{{ series.owner.email }}">{{ series.owner.email }}</a></p>
                    {% if series.owner.nigend %}<p class="fr-text--sm fr-mb-1v"><strong>NIGEND :</strong> {{ series.owner.nigend }}</p>{% endif %}
                {% endif %}

                <hr class="fr-my-3w">

                <h3 class="fr-h5 fr-mb-2w">Ressource(s)</h3>
                {% for link in series.reservationResources %}
                    <p class="fr-tag fr-mb-1w">{{ link.resource.name }}</p>
                {% endfor %}

                <hr class="fr-my-3w">

                <h3 class="fr-h5 fr-mb-2w">Actions</h3>

                {% if series.status.id == 1 %}
                    <form method="post" action="{{ path('admin_reservation_approve', { id: series.id }) }}" class="fr-mb-2w">
                        <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ series.id) }}">
                        <button class="fr-btn fr-btn--success fr-btn--wide fr-icon-check-line fr-btn--icon-left">
                            Approuver
                        </button>
                    </form>

                    <button class="fr-btn fr-btn--secondary fr-btn--wide fr-icon-close-circle-line fr-btn--icon-left"
                            aria-controls="modal-reject-{{ series.id }}">
                        Refuser
                    </button>

                    <dialog id="modal-reject-{{ series.id }}" class="fr-modal" role="dialog">
                        <div class="fr-container fr-container--fluid fr-container-md">
                            <div class="fr-grid-row fr-grid-row--center">
                                <div class="fr-col-12 fr-col-md-8">
                                    <div class="fr-modal__body">
                                        <div class="fr-modal__header">
                                            <button class="fr-btn--close fr-btn" aria-controls="modal-reject-{{ series.id }}">Fermer</button>
                                        </div>
                                        <div class="fr-modal__content">
                                            <h1 class="fr-modal__title">Motif du refus</h1>
                                            <form method="post" action="{{ path('admin_reservation_reject', { id: series.id }) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ series.id) }}">
                                                <div class="fr-form-group">
                                                    <label class="fr-label" for="reason">Raison (obligatoire)</label>
                                                    <textarea class="fr-input" id="reason" name="reason" rows="3" required></textarea>
                                                </div>
                                                <button type="submit" class="fr-btn fr-btn--danger fr-mt-2w">Confirmer le refus</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </dialog>
                {% endif %}

                {% if series.status.id in [1, 2] %}
                    <form method="post" action="{{ path('admin_reservation_cancel', { id: series.id }) }}"
                          class="fr-mt-2w"
                          onsubmit="return confirm('Annuler cette réservation ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ series.id) }}">
                        <button class="fr-btn fr-btn--tertiary-no-outline fr-btn--wide fr-icon-delete-line fr-btn--icon-left">
                            Annuler la réservation
                        </button>
                    </form>
                {% endif %}

            </div>
        </div>
    </div>
</div>
{% endblock %}
