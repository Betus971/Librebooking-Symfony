{% extends 'base.html.twig' %}

{% block title %}Gérer les groupes - {{ user.email }}{% endblock %}

{% block body %}
    <div class="fr-container fr-mt-4w">
        <h1>Gérer les équipes de {{ user.fname }} {{ user.lname }}</h1>

        <p>Sélectionnez les équipes dont fait partie cet utilisateur. Cela définira quelles salles et plannings il a le droit de gérer.</p>

        {{ form_start(form) }}
        {{ form_widget(form) }}
        <button class="fr-btn fr-mt-2w" type="submit">Enregistrer les groupes</button>
        <a href="{{ path('app_admin_user') }}" class="fr-btn fr-btn--secondary fr-mt-2w">Annuler</a>
        {{ form_end(form) }}
    </div>
{% endblock %}
