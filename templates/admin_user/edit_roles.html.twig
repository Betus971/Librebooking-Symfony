{% extends 'base.html.twig' %}

{% block title %}Modifier les droits{% endblock %}

{% block body %}
    <div class="fr-container fr-mt-4w">
        <div class="fr-grid-row fr-grid-row--center">
            <div class="fr-col-md-8">
                <h1>Modifier les droits : {{ user.email }}</h1>

                <div class="fr-alert fr-alert--info fr-mb-4w">
                    <p>Cochez les modules auxquels cet utilisateur doit avoir accès.</p>
                </div>

                {{ form_start(form) }}

                <div class="fr-form-group">
                    <fieldset class="fr-fieldset">
                        <legend class="fr-fieldset__legend">Rôles disponibles</legend>
                        <div class="fr-fieldset__content">
                            {# On boucle sur les choix pour les afficher joliment #}
                            {% for child in form.roles %}
                                <div class="fr-checkbox-group">
                                    {{ form_widget(child) }}
                                    {{ form_label(child) }}
                                </div>
                            {% endfor %}
                        </div>
                    </fieldset>
                </div>

                <div class="fr-mt-2w">
                    {{ form_row(form.save) }}
                    <a href="{{ path('app_admin_user') }}" class="fr-btn fr-btn--secondary">Annuler</a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
