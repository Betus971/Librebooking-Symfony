{# Flashes par clés nommées. Usage : include avec keys = ['planning.succes','planning.error'] #}
{% for key in keys|default([]) %}
    {% for message in app.flashes(key) %}
        {% set variant = 'info' %}
        {% if 'success' in key or 'succes' in key %}{% set variant = 'success' %}
        {% elseif 'error' in key or 'erreur' in key %}{% set variant = 'error' %}
        {% elseif 'warning' in key %}{% set variant = 'warning' %}{% endif %}

        <div class="alert alert-{{ variant }} shadow-sm mb-3" role="status">
            <span class="text-sm">{{ message }}</span>
            <button type="button" class="btn btn-ghost btn-xs" title="{{ 'common.dismiss'|trans }}"
                    onclick="this.closest('.alert').remove()">✕</button>
        </div>
    {% endfor %}
{% endfor %}
