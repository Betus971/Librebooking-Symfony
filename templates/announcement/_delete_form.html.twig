{#
  Formulaire inline de suppression d'annonce.

  Rendu DSFR : bouton tertiaire rouge, icône corbeille, libellé explicite,
  confirmation native par dialogue. À inclure dans les en-têtes show/edit.
#}
<form method="post"
      action="{{ path('app_announcement_delete', {'id': announcement.id}) }}"
      onsubmit="return confirm('Supprimer définitivement cette annonce ?');"
      class="fr-display-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ announcement.id) }}">
    <button type="submit" class="fr-btn fr-btn--tertiary fr-icon-delete-line fr-btn--icon-left">
        Supprimer
    </button>
</form>
