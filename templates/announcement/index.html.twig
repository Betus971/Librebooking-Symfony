{% extends 'base.html.twig' %}

{% block title %}Announcement index{% endblock %}

{% block body %}
    <div class="fr-container fr-my-4w">
        {# En-tête avec Titre et Bouton Créer #}
        <div class="fr-grid-row fr-grid-row--middle fr-mb-3w">
            <div class="fr-col">
                <h1 class="fr-h3">📢 Gestion des Annonces</h1>
            </div>
            <div class="fr-col fr-text--right">
                <a href="{{ path('app_announcement_new') }}" class="fr-btn fr-btn--icon-left fr-icon-add-line">
                    Nouvelle annonce
                </a>
            </div>
        </div>

        <div class="fr-table fr-table--bordered">
            <table>
                <thead>
                <tr>
                    <th scope="col">Message</th>
                    <th scope="col">Diffusion</th>
                    <th scope="col">Priorité</th>
                    <th scope="col" class="fr-text--right">Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for announcement in announcements %}
                    <tr>
                        <td>
                            <span class="fr-text--bold">{{ announcement.message|slice(0, 60) }}...</span>
                        </td>
                        <td>
                            <p class="fr-m-0 fr-text--xs">
                                <span class="fr-icon-calendar-line fr-icon--sm" aria-hidden="true"></span>
                                Début : {{ announcement.startDate ? announcement.startDate|date('d/m/Y H:i') : '-' }}
                            </p>
                            <p class="fr-m-0 fr-text--xs">
                                <span class="fr-icon-calendar-check-line fr-icon--sm" aria-hidden="true"></span>
                                Fin : &nbsp;&nbsp;&nbsp;{{ announcement.endDate ? announcement.endDate|date('d/m/Y H:i') : '-' }}
                            </p>
                        </td>
                        <td>
                            {# Badges DSFR alignés sur les 4 niveaux du formulaire (1..4). #}
                            {% if announcement.priority == 4 %}
                                <p class="fr-badge fr-badge--error fr-badge--no-icon">Urgent</p>
                            {% elseif announcement.priority == 3 %}
                                <p class="fr-badge fr-badge--warning fr-badge--no-icon">Avertissement</p>
                            {% elseif announcement.priority == 2 %}
                                <p class="fr-badge fr-badge--success fr-badge--no-icon">Succès</p>
                            {% else %}
                                <p class="fr-badge fr-badge--info fr-badge--no-icon">Information</p>
                            {% endif %}
                        </td>
                        <td class="fr-text--right">
                            <ul class="fr-btns-group fr-btns-group--inline fr-btns-group--sm fr-btns-group--right">
                                <li>
                                    <a href="{{ path('app_announcement_show', {'id': announcement.id}) }}" class="fr-btn fr-btn--secondary fr-btn--sm fr-icon-eye-line" title="Voir">
                                    </a>
                                </li>
                                <li>
                                    <a href="{{ path('app_announcement_edit', {'id': announcement.id}) }}" class="fr-btn fr-btn--tertiary fr-btn--sm fr-icon-edit-line" title="Éditer">
                                    </a>
                                </li>
                            </ul>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="fr-text--center">Aucune annonce enregistrée.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
