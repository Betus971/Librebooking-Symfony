{% extends 'base.html.twig' %}

{% block title %}Announcement{% endblock %}

{% block body %}
    <div class="fr-container fr-my-4w">

        {# Fil d'Ariane #}
        <nav role="navigation" class="fr-breadcrumb" aria-label="vous êtes ici :">
            <button class="fr-breadcrumb__button" aria-expanded="false" aria-controls="breadcrumb-1">Voir le fil d’Ariane</button>
            <div class="fr-collapse" id="breadcrumb-1">
                <ol class="fr-breadcrumb__list">
                    <li><a class="fr-breadcrumb__link" href="{{ path('app_home') }}">Accueil</a></li>
                    <li><a class="fr-breadcrumb__link" href="{{ path('app_announcement_index') }}">Annonces</a></li>
                    <li><a class="fr-breadcrumb__link" aria-current="page">Annonce #{{ announcement.id }}</a></li>
                </ol>
            </div>
        </nav>

        <div class="fr-grid-row fr-grid-row--center">
            <div class="fr-col-12 fr-col-md-8">

                <div class="fr-card fr-card--grey fr-p-3w">
                    <div class="fr-card__body">
                        <div class="fr-card__content">
                            <h2 class="fr-card__title">Contenu de l'annonce</h2>

                            {# Message mis en avant #}
                            <div class="fr-alert fr-alert--info fr-mb-3w">
                                <p>{{ announcement.message }}</p>
                            </div>

                            <div class="fr-grid-row fr-grid-row--gutters">
                                <div class="fr-col-6">
                                    <p class="fr-text--sm fr-mb-1w fr-text--bold">Date de début</p>
                                    <p class="fr-tag fr-tag--sm fr-icon-calendar-line fr-tag--icon-left">
                                        {{ announcement.startDate ? announcement.startDate|date('d/m/Y H:i') : '-' }}
                                    </p>
                                </div>
                                <div class="fr-col-6">
                                    <p class="fr-text--sm fr-mb-1w fr-text--bold">Date de fin</p>
                                    <p class="fr-tag fr-tag--sm fr-icon-calendar-check-line fr-tag--icon-left">
                                        {{ announcement.endDate ? announcement.endDate|date('d/m/Y H:i') : '-' }}
                                    </p>
                                </div>
                            </div>

                            <div class="fr-mt-2w">
                                <p class="fr-text--sm">Priorité définie : <strong>{{ announcement.priority }}</strong></p>
                            </div>
                        </div>

                        <div class="fr-card__footer fr-mt-3w">
                            <ul class="fr-btns-group fr-btns-group--inline">
                                <li>
                                    <a href="{{ path('app_announcement_edit', {'id': announcement.id}) }}" class="fr-btn fr-btn--secondary fr-icon-edit-line fr-btn--icon-left">
                                        Modifier
                                    </a>
                                </li>
                                <li>
                                    {# Inclusion du formulaire de suppression (le bouton sera à styliser si besoin) #}
                                    {{ include('announcement/_delete_form.html.twig') }}
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="fr-mt-2w">
            <a href="{{ path('app_announcement_index') }}" class="fr-link fr-icon-arrow-left-line fr-link--icon-left">Retour à la liste</a>
        </div>
    </div>
{% endblock %}
