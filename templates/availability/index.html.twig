{% extends 'base.html.twig' %}

{% block title %}{{ 'availability.title'|trans }} - Librebooking{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto">
    {# Filtres #}
    <form method="get" class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end mb-4">
        <div class="md:col-span-3">
            <label class="label" for="start"><span class="label-text">{{ 'availability.week'|trans }}</span></label>
            <input id="start" name="start" type="date" class="input input-bordered w-full" value="{{ weekStart|date('Y-m-d') }}" onchange="this.form.submit()">
        </div>
        <div class="md:col-span-3">
            <label class="label" for="type"><span class="label-text">{{ 'availability.resource_type'|trans }}</span></label>
            <select id="type" name="type" class="select select-bordered w-full" onchange="this.form.submit()">
                <option value="">{{ 'availability.all'|trans }}</option>
                {% for category in filters.categories %}
                    <option value="{{ category.id }}" {{ category.id == app.request.get('type') ? 'selected' : '' }}>{{ category.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="md:col-span-2">
            <label class="label" for="cap"><span class="label-text">{{ 'availability.min_capacity'|trans }}</span></label>
            <input id="cap" name="cap" type="number" min="1" class="input input-bordered w-full" value="{{ app.request.get('cap') }}">
        </div>
        <div class="md:col-span-2">
            <button class="btn btn-primary w-full">{{ 'availability.filter'|trans }}</button>
        </div>
    </form>

    {# Navigation semaine #}
    <div class="flex items-center justify-between mb-3">
        <a class="btn btn-ghost btn-sm" href="{{ path('app_availability', app.request.query.all|merge({'start': (weekStart|date_modify('-7 day'))|date('Y-m-d')})) }}">{{ 'availability.prev_week'|trans }}</a>
        <span class="font-semibold">{{ days|first|date('d/m/Y') }} – {{ days|last|date('d/m/Y') }}</span>
        <a class="btn btn-ghost btn-sm" href="{{ path('app_availability', app.request.query.all|merge({'start': (weekStart|date_modify('+7 day'))|date('Y-m-d')})) }}">{{ 'availability.next_week'|trans }}</a>
    </div>

    {# Tableau disponibilités #}
    <div class="overflow-x-auto card bg-base-100 border border-base-300 shadow-sm">
        <table class="table table-fixed">
            <thead>
                <tr>
                    <th class="w-56">{{ 'availability.resources'|trans }}</th>
                    {% for d in days %}
                        <th>{{ d|format_datetime(pattern='EEE d MMM', locale=app.request.locale)|capitalize }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
            {% for r in resources %}
                <tr>
                    <th scope="row">{{ r.name }}</th>
                    {% for d in days %}
                        {% set key = d|date('Y-m-d') %}
                        {% set slots = (matrix[r.id][key] ?? []) %}
                        <td class="text-center">
                            {% if slots is not empty %}
                                <button type="button"
                                        class="badge badge-success gap-1 cursor-pointer js-more"
                                        data-rid="{{ r.id }}" data-date="{{ key }}"
                                        title="{{ 'availability.see_slots_title'|trans({'%count%': slots|length}) }}">
                                    {{ 'availability.available_count'|trans({'%count%': slots|length}) }}
                                </button>
                            {% else %}
                                <span class="text-base-content/30">—</span>
                            {% endif %}
                        </td>
                    {% endfor %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# Modale créneaux (DaisyUI) #}
<dialog id="slots-modal" class="modal">
    <div class="modal-box max-w-2xl">
        <h3 class="font-bold text-lg mb-3">{{ 'availability.availability_of'|trans }} <span id="modal-date-label">…</span></h3>
        <div id="modal-slots-container" class="grid grid-cols-2 sm:grid-cols-3 gap-2"></div>
        <div class="modal-action">
            <form method="dialog"><button class="btn btn-ghost btn-sm">{{ 'common.close'|trans }}</button></form>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>

<script>
    (function () {
        const modal = document.getElementById('slots-modal');
        const modalTitleDate = document.getElementById('modal-date-label');
        const modalContainer = document.getElementById('modal-slots-container');
        const newUrl = '{{ path('reservation_new') }}';
        const locale = '{{ app.request.locale }}';
        if (!modalContainer) return;

        document.body.addEventListener('click', (e) => {
            const btn = e.target.closest('.js-more');
            if (!btn) return;
            e.preventDefault();

            const resourceId = btn.dataset.rid;
            const dateStr = btn.dataset.date;
            modalTitleDate.textContent = new Date(dateStr).toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long' });

            modalContainer.innerHTML = '<div class="col-span-full text-center py-6"><span class="loading loading-spinner text-primary"></span></div>';
            modal.showModal();

            fetch('{{ path('app_availability_slots') }}?resource=' + resourceId + '&date=' + dateStr)
                .then(r => r.json())
                .then(list => {
                    if (!list.length) {
                        modalContainer.innerHTML = '<p class="col-span-full text-sm text-base-content/60">{{ 'availability.no_slots'|trans|e('js') }}</p>';
                        return;
                    }
                    modalContainer.innerHTML = '';
                    list.forEach(s => {
                        if (s.available) {
                            const a = document.createElement('a');
                            a.className = 'btn btn-outline btn-primary btn-sm';
                            a.href = newUrl + '?resource=' + encodeURIComponent(resourceId)
                                + '&date=' + encodeURIComponent(dateStr)
                                + '&start=' + encodeURIComponent(s.start)
                                + '&end=' + encodeURIComponent(s.end);
                            a.textContent = s.label != null ? String(s.label) : '';
                            modalContainer.appendChild(a);
                        } else {
                            const span = document.createElement('span');
                            span.className = 'btn btn-disabled btn-sm line-through opacity-40';
                            span.textContent = s.label != null ? String(s.label) : '';
                            modalContainer.appendChild(span);
                        }
                    });
                })
                .catch(() => {
                    modalContainer.innerHTML = '<div class="col-span-full alert alert-error text-sm">{{ 'availability.load_error'|trans|e('js') }}</div>';
                });
        });
    })();
</script>
{% endblock %}
