<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Librebooking{% endblock %}</title>
    
    {# Applique le thème avant le rendu pour éviter tout flash (clé localStorage 'theme'). #}
    <script>document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'dark');</script>

    {# Modern Font (Inter & Outfit) #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="min-h-screen flex flex-col bg-base-200 text-base-content antialiased">
    {# Header / Menu #}
    {% include 'header/menu.html.twig' %}

    {# Global Flash Messages via DaisyUI Toast #}
    {% set _allFlashes = app.flashes %}
    {% if _allFlashes|length > 0 %}
        <div class="toast toast-top toast-end z-50 mt-16">
            {% for label, messages in _allFlashes %}
                {% for message in messages %}
                    {% if message is not empty and message != '…' %}
                        {% set alertClass = 'alert-info' %}
                        {% if 'success' in label or 'succes' in label %}
                            {% set alertClass = 'alert-success' %}
                        {% elseif 'warning' in label %}
                            {% set alertClass = 'alert-warning' %}
                        {% elseif 'danger' in label or 'error' in label %}
                            {% set alertClass = 'alert-error' %}
                        {% endif %}
                        <div class="alert {{ alertClass }} shadow-lg">
                            <span>{{ message }}</span>
                        </div>
                    {% endif %}
                {% endfor %}
            {% endfor %}
        </div>
    {% endif %}

    {# Main Content #}
    <main class="flex-grow max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8">
        {% block body %}{% endblock %}
    </main>

    {# Footer #}
    {% include 'header/footer.html.twig' %}

    {# Bascule de thème clair/sombre — pilotée par data-theme (DaisyUI). #}
    <script>
        function applyThemeIcons(theme) {
            const sun  = document.getElementById('theme-icon-sun');
            const moon = document.getElementById('theme-icon-moon');
            if (!sun || !moon) return;
            // Thème sombre → on propose de passer en clair (soleil). Inverse en clair.
            sun.classList.toggle('hidden', theme === 'light');
            moon.classList.toggle('hidden', theme !== 'light');
        }
        function setTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('theme', theme);
            applyThemeIcons(theme);
        }
        function toggleDarkLight() {
            const current = document.documentElement.getAttribute('data-theme') || 'dark';
            setTheme(current === 'dark' ? 'light' : 'dark');
        }
        // Synchronise l'icône au chargement (et après chaque navigation Turbo).
        function syncThemeToggle() {
            applyThemeIcons(localStorage.getItem('theme') || 'dark');
        }
