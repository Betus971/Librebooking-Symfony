<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Librebooking{% endblock %}</title>
    
    <script>
        // Immediately set the theme to avoid visual flashing
        (function() {
            const isDark = localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches);
            if (isDark) {
                document.documentElement.classList.add('dark');
                document.documentElement.setAttribute('data-theme', 'dark');
            } else {
                document.documentElement.classList.remove('dark');
                document.documentElement.setAttribute('data-theme', 'light');
            }

            // Sync future class modifications by Stimulus controllers to data-theme attribute
            const observer = new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                    if (mutation.attributeName === 'class') {
                        const darkActive = document.documentElement.classList.contains('dark');
                        document.documentElement.setAttribute('data-theme', darkActive ? 'dark' : 'light');
                    }
                });
            });
            document.addEventListener('DOMContentLoaded', () => {
                observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
            });
        })();
    </script>

    {# Modern Font (Inter & Outfit) #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="min-h-screen flex flex-col bg-base-200 text-base-content antialiased">
    {# Header / Menu #}
    {% include 'header/menu.html.twig' %}

    {# Global Flash Messages via DaisyUI Toast #}
    {% set _allFlashes = app.flashes %}
    {% if _allFlashes|length > 0 %}
        <div class="toast toast-top toast-end z-50 mt-16">
            {% for label, messages in _allFlashes %}
                {% for message in messages %}
                    {% if message is not empty and message != '…' %}
                        {% set alertClass = 'alert-info' %}
                        {% if 'success' in label or 'succes' in label %}
                            {% set alertClass = 'alert-success' %}
                        {% elseif 'warning' in label %}
                            {% set alertClass = 'alert-warning' %}
                        {% elseif 'danger' in label or 'error' in label %}
                            {% set alertClass = 'alert-error' %}
                        {% endif %}
                        <div class="alert {{ alertClass }} shadow-lg">
                            <span>{{ message }}</span>
                        </div>
                    {% endif %}
                {% endfor %}
            {% endfor %}
        </div>
    {% endif %}

    {# Main Content #}
    <main class="flex-grow max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8">
        {% block body %}{% endblock %}
    </main>

    {# Footer #}
    {% include 'header/footer.html.twig' %}
</body>
</html>
