<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Erreur {{ status_code }}</title>
    <link rel="stylesheet"
          href="/assets/dsfr/dsfr.min.css"
          onerror="this.onerror=null;">
    <style>
        body { font-family: Marianne, Arial, sans-serif; background: #f6f6f6; margin: 0; }
        .error-wrapper { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem; }
        .error-card { background: #fff; border-radius: 4px; box-shadow: 0 2px 6px rgba(0,0,0,.12); max-width: 640px; width: 100%; padding: 3rem 2.5rem; text-align: center; }
        .error-code { font-size: 5rem; font-weight: 700; color: #000091; line-height: 1; margin-bottom: .5rem; }
        .error-title { font-size: 1.5rem; font-weight: 700; color: #1e1e1e; margin-bottom: 1rem; }
        .error-desc { color: #3a3a3a; margin-bottom: 2rem; line-height: 1.6; }
        .btn-group { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
        .btn-primary { background: #000091; color: #fff; padding: .625rem 1.5rem; border-radius: 4px; text-decoration: none; font-weight: 600; border: none; cursor: pointer; }
        .btn-primary:hover { background: #1212ff; }
        .btn-secondary { background: transparent; color: #000091; padding: .625rem 1.5rem; border-radius: 4px; text-decoration: none; font-weight: 600; border: 2px solid #000091; cursor: pointer; }
        .btn-secondary:hover { background: #f0f0ff; }
    </style>
</head>
<body>
<div class="error-wrapper">
    <div class="error-card">
        <div class="error-code">{{ status_code }}</div>
        <h1 class="error-title">
            {% if status_code == 403 %}Accès refusé
            {% elseif status_code == 404 %}Page introuvable
            {% elseif status_code == 503 %}Service temporairement indisponible
            {% else %}Une erreur est survenue
            {% endif %}
        </h1>
        <p class="error-desc">
            {% if status_code == 403 %}
                Vous n'avez pas les droits nécessaires pour accéder à cette page.
            {% elseif status_code == 404 %}
                La page que vous cherchez n'existe pas ou a été déplacée.
            {% elseif status_code == 503 %}
                L'application est temporairement indisponible pour maintenance. Merci de réessayer dans quelques instants.
            {% else %}
                Une erreur inattendue s'est produite. Merci de réessayer.
            {% endif %}
        </p>
        <div class="btn-group">
            <a class="btn-primary" href="/">Retour à l'accueil</a>
            {% if status_code != 403 %}
            <button class="btn-secondary" onclick="history.back();">Page précédente</button>
            {% endif %}
        </div>
    </div>
</div>
</body>
</html>
