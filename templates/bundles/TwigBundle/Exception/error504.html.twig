{% extends 'base.html.twig' %}

{% block title %}{{ 'errors.error_word'|trans }} 504 - {{ 'errors.e504_title'|trans }}{% endblock %}

{% block body %}
    <div class="max-w-xl mx-auto text-center py-16">
        <h1 class="text-5xl font-extrabold text-base-content">504</h1>
        <p class="text-lg mt-2">{{ 'errors.e504_lead'|trans }}</p>
        <p class="text-sm text-base-content/60 mt-3 mb-6">
            {{ 'errors.e504_desc'|trans }}
        </p>
        <div class="flex justify-center gap-3">
            <button class="btn btn-primary" onclick="window.location.reload();">{{ 'errors.refresh'|trans }}</button>
            <a class="btn btn-ghost" href="{{ path('app_home') }}">{{ 'errors.back_home'|trans }}</a>
        </div>
    </div>
{% endblock %}
