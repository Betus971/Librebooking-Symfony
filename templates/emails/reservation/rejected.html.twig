{% extends 'emails/reservation/_layout.html.twig' %}

{% block content %}
    <h1 style="font-size:20px;margin:0 0 12px;color:#b91c1c;">{{ 'email.rejected_title'|trans }}</h1>
    <p style="margin:0 0 8px;line-height:1.5;">
        {{ 'email.greeting'|trans({'%name%': series.owner.fname|default('')}) }}
    </p>
    <p style="margin:0 0 8px;line-height:1.5;">
        {{ 'email.rejected_body'|trans }}
    </p>
    {% if reason is defined and reason %}
        <p style="margin:0 0 8px;line-height:1.5;padding:12px;background:#fef2f2;border-left:3px solid #b91c1c;border-radius:4px;">
            <strong>{{ 'email.reason_label'|trans }}</strong> {{ reason }}
        </p>
    {% endif %}
    {{ include('emails/reservation/_summary.html.twig') }}
{% endblock %}
