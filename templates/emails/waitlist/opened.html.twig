{% extends 'emails/reservation/_layout.html.twig' %}

{% block content %}
    <h1 style="font-size:20px;margin:0 0 12px;color:#047857;">{{ 'email.waitlist_title'|trans }}</h1>
    <p style="margin:0 0 8px;line-height:1.5;">
        {{ 'email.greeting'|trans({'%name%': waitlist.user.fname|default('')}) }}
    </p>
    <p style="margin:0 0 8px;line-height:1.5;">
        {{ 'email.waitlist_body'|trans }}
    </p>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:16px 0;border-collapse:collapse;">
        <tr>
            <td style="padding:8px 0;color:#6b7280;width:140px;">{{ 'email.resource'|trans }}</td>
            <td style="padding:8px 0;font-weight:bold;">{{ waitlist.resource.name }}</td>
        </tr>
        <tr>
            <td style="padding:8px 0;color:#6b7280;">{{ 'email.slot'|trans }}</td>
            <td style="padding:8px 0;">
                {{ 'email.range'|trans({'%start%': waitlist.startDate|date('d/m/Y H:i'), '%end%': waitlist.endDate|date('d/m/Y H:i')}) }}
            </td>
        </tr>
    </table>
{% endblock %}
