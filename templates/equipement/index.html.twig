{% extends 'base.html.twig' %}
{% block title %}Équipements — Administration{% endblock %}
{% block body %}
<div class="max-w-5xl mx-auto py-8">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-3xl font-extrabold text-base-content">Équipements</h1>
        <a href="{{ path('app_equipement_new') }}" class="btn btn-primary btn-sm">+ Ajouter</a>
    </div>
    <div class="overflow-x-auto card bg-base-100 border border-base-200 shadow-sm">
        <table class="table table-zebra">
            <thead><tr><th>Nom</th><th>Actif</th><th class="text-right">Actions</th></tr></thead>
            <tbody>
            {% for e in equipements %}
                <tr class="hover">
                    <td class="font-semibold">{{ e.nom }}</td>
                    <td>{% if e.actif %}<span class="badge badge-success badge-sm">Oui</span>{% else %}<span class="badge badge-ghost badge-sm">Non</span>{% endif %}</td>
                    <td class="text-right">
                        <div class="flex justify-end gap-1">
                            <a href="{{ path('app_equipement_edit', {id: e.id}) }}" class="btn btn-ghost btn-xs">Modifier</a>
                            <form method="post" action="{{ path('app_equipement_delete', {id: e.id}) }}" onsubmit="return confirm('Supprimer cet équipement ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ e.id) }}">
                                <button class="btn btn-ghost btn-xs text-error">Suppr.</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="3" class="text-center py-8 text-base-content/60">Aucun équipement.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
