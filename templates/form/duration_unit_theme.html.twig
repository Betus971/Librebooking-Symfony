{% block duration_unit_widget %}
    <div class="fr-grid-row fr-grid-row--gutters" style="margin-top: 0; padding-top: 0;">
        <div class="fr-col-7 fr-col-md-8">
            {# On utilise children['value'] avec des crochets pour éviter que Twig ne confonde avec le mot réservé ! #}
            {{ form_widget(form.children['value']) }}
        </div>
        <div class="fr-col-5 fr-col-md-4">
            {{ form_widget(form.children['unit']) }}
        </div>
    </div>
{% endblock %}
