{% set route = app.request.attributes.get('_route') %}

{# --- 1. HEADER (Partie visible tout le temps) --- #}
<header role="banner" class="fr-header">
    <div class="fr-header__body">
        <div class="fr-container">
            <div class="fr-header__body-row">

                {# A. LA MARQUE (Logo + Titre) #}
                <div class="fr-header__brand fr-enlarge-link">
                    <div class="fr-header__brand-top">
                        <div class="fr-header__logo">
                            <p class="fr-logo">République<br>Française</p>
                        </div>
                        <div class="fr-header__navbar">
                            <button data-fr-opened="false" aria-controls="modal-mainmenu" title="Menu" type="button" id="btn-mainmenu" class="fr-btn--menu fr-btn">Menu</button>
                        </div>
                    </div>
                    <div class="fr-header__service">
                        <a href="{{ path('app_home') }}" title="Accueil - Accueil & Réservation">
                            <p class="fr-header__service-title">Accueil & Réservation</p>
                        </a>
                        <p class="fr-header__service-tagline">DGGN</p>
                    </div>
                </div>

                {# B. LES OUTILS (Connexion / Déconnexion) #}
                <div class="fr-header__tools">
                    <div class="fr-header__tools-links">
                        <ul class="fr-btns-group">
                            <li>
                                <button id="theme-toggle" class="fr-btn fr-icon-moon-line" title="Basculer le thème" type="button" aria-label="Basculer le thème sombre"></button>
                            </li>
                            {% if app.user %}
                                <li>
                                    <a class="fr-btn fr-icon-account-circle-line" href="#">
                                        {{ app.user.fname ?? app.user.email }}
                                    </a>
                                </li>
                                <li>
                                    <a class="fr-btn fr-icon-logout-box-r-line" href="{{ path('app_logout') }}">
                                        Déconnexion
                                    </a>
                                </li>
                            {% else %}
                                <li>
                                    <a class="fr-btn fr-icon-lock-line" href="{{ path('app_login') }}">
                                        Se connecter
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                        <script>
                            (function() {
                                const html = document.documentElement;
                                const btn = document.getElementById('theme-toggle');
                                const stored = localStorage.getItem('fr-scheme');
                                const scheme = stored || 'system';
                                html.setAttribute('data-fr-scheme', scheme);

                                function updateIcon() {
                                    const current = html.getAttribute('data-fr-scheme');
                                    btn.classList.toggle('fr-icon-moon-line', current !== 'dark');
                                    btn.classList.toggle('fr-icon-sun-line', current === 'dark');
                                }
                                updateIcon();

                                btn.addEventListener('click', function() {
                                    const current = html.getAttribute('data-fr-scheme');
                                    const next = current === 'dark' ? 'light' : 'dark';
                                    html.setAttribute('data-fr-scheme', next);
                                    localStorage.setItem('fr-scheme', next);
                                    updateIcon();
                                });
                            })();
                        </script>
                    </div>
                </div>

            </div>
        </div>
    </div>

    {# --- 2. LE MENU (Partie cachée qui s'ouvre) --- #}
    <div class="fr-header__menu fr-modal" id="modal-mainmenu" aria-labelledby="btn-mainmenu">
        <div class="fr-container">
            <button aria-controls="modal-mainmenu" title="Fermer" type="button" id="btn-closemenu" class="fr-btn--close fr-btn">Fermer</button>
            <div class="fr-header__menu-links"></div>

            <nav class="fr-nav" id="navigation-main" role="navigation" aria-label="Menu principal">
                <ul class="fr-nav__list">

                    {# LIEN 1 : ACCUEIL #}
                    <li class="fr-nav__item">
                        <a href="{{ path('app_home') }}" class="fr-nav__link" {% if route == 'app_home' %}aria-current="page"{% endif %}>Accueil</a>
                    </li>

                    {% if app.user %}
                        {# LIEN 2 : VISITEURS #}
                        <li class="fr-nav__item">
                            <button class="fr-nav__btn" aria-expanded="false" aria-controls="menu-visiteurs">Visiteurs</button>
                            <div class="fr-collapse fr-menu" id="menu-visiteurs">
                                <ul class="fr-menu__list">
                                    <li><a class="fr-nav__link" href="{{ path('app_visiteur_new') }}">Déclarer un visiteur</a></li>
                                    <li><a class="fr-nav__link" href="{{ path('app_visiteur_groupe') }}">Déclaration groupée (délégation)</a></li>
                                    <li><a class="fr-nav__link" href="{{ path('app_visiteur_index') }}">Mes visiteurs</a></li>
                                </ul>
                            </div>
                        </li>

                        {# LIEN 3 : RÉSERVATIONS (Mis à jour) #}
                        <li class="fr-nav__item">
                            <button class="fr-nav__btn" aria-expanded="false" aria-controls="menu-reservations">Réservations</button>
                            <div class="fr-collapse fr-menu" id="menu-reservations">
                                <ul class="fr-menu__list">
                                    {# On a retiré "Nouvelle réservation" pour forcer à passer par le calendrier #}
                                    <li><a class="fr-nav__link" href="{{ path('app_calendar') }}">Calendrier</a></li>
                                    <li><a class="fr-nav__link" href="{{ path('app_calendar_v2') }}">Calendrier V2</a></li>
                                    <li><a class="fr-nav__link" href="{{ path('app_availability') }}">Disponibilités</a></li>
                                    <li><a class="fr-nav__link" href="{{ path('reservation_mine') }}">Mes réservations</a></li>
                                </ul>
                            </div>
                        </li>

                        {# LIEN 4 : SÉCURITÉ #}
                        {% if is_granted('ROLE_AGENT_ACCUEIL') %}
                            <li class="fr-nav__item">
                                <button class="fr-nav__btn" aria-expanded="false" aria-controls="menu-secu">Sécurité / Accueil</button>
                                <div class="fr-collapse fr-menu" id="menu-secu">
                                    <ul class="fr-menu__list">
                                        <li><a class="fr-nav__link" href="{{ path('app_gestion_visiteur') }}">Gestion des visiteurs </a></li>
                                        <li><a class="fr-nav__link" href="{{ path('app_badge_attribution_index') }}">Gestion attribution </a></li>
                                        {% if is_granted('ROLE_ADMIN_BADGE') %}
                                            <li><a class="fr-nav__link" href="{{ path('app_badge_index') }}">Gestion Badges</a></li>
                                            <li><a class="fr-nav__link" href="{{ path('app_badge_type_index') }}">Types de badges</a></li>
                                            <li><a class="fr-nav__link" href="{{ path('app_ifpr_index') }}">Fichier IFPR</a></li>
                                            <li><a class="fr-nav__link" href="{{ path('app_statistique') }}">Statistique des visites </a></li>
                                        {% endif %}
                                    </ul>
                                </div>
                            </li>
                        {% endif %}

                        {# LIEN 5 : ADMIN RESSOURCE #}
                        {% if is_granted('ROLE_ADMIN_RESSOURCE') %}
                            <li class="fr-nav__item">
                                <button class="fr-nav__btn" aria-expanded="false" aria-controls="menu-admin">Gestion / Ressource</button>
                                <div class="fr-collapse fr-menu" id="menu-admin">
                                    <ul class="fr-menu__list">
                                        <li><a class="fr-nav__link" href="{{ path('admin_reservation_pending') }}">Validations en attente</a></li>
                                        <li><a class="fr-nav__link" href="{{ path('admin_reservation_index') }}">Historique</a></li>
                                        <li><a class="fr-nav__link" href="{{ path('app_resource_index') }}">Salles </a></li>
                                        <li><a class="fr-nav__link" href="{{ path('app_resource_category_index') }}">Catégories</a></li>  {# ← AJOUTÉ #}
                                        <li><a class="fr-nav__link" href="{{ path('app_schedule_index') }}">Plannings</a></li>
                                        <li><a class="fr-nav__link" href="{{ path('app_announcement_index') }}">Annonces</a></li>
                                    </ul>
                                </div>
                            </li>
                        {% endif %}

                        {# LIEN 6 : SUPER ADMIN (Mis à jour) #}
                        {% if is_granted('ROLE_SUPER_ADMIN') %}
                            <li class="fr-nav__item">
                                <button class="fr-nav__btn" aria-expanded="false" aria-controls="menu-superadmin">Super Admin</button>
                                <div class="fr-collapse fr-menu" id="menu-superadmin">
                                    <ul class="fr-menu__list">
                                        <li><a class="fr-nav__link" href="{{ path('app_admin_user') }}">Utilisateurs & Rôles</a></li>
                                        {# NOUVEAU LIEN POUR GERER LES GROUPES : #}
                                        <li><a class="fr-nav__link" href="{{ path('app_resource_group_index') }}">Équipes / Groupes</a></li>
                                    </ul>
                                </div>
                            </li>
                        {% endif %}
                    {% endif %}

                </ul>
            </nav>
        </div>
    </div>
</header>
