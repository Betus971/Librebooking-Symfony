{% set route = app.request.attributes.get('_route') %}

<nav class="navbar bg-base-100 border-b border-base-300 sticky top-0 z-50 px-4 sm:px-6 lg:px-8 min-h-[4rem] shadow-sm">
    {# NAVBAR START: Logo & Mobile Dropdown #}
    <div class="navbar-start gap-1">
        <div class="dropdown">
            <div tabindex="0" role="button" class="btn btn-ghost btn-circle lg:hidden hover:bg-base-300 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
            </div>
            <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[50] p-2 shadow-xl bg-base-100 border border-base-300 rounded-xl w-52">
                <li>
                    <a href="{{ path('app_home') }}" class="{% if route == 'app_home' %}active{% endif %}">
                        {{ 'menu.home'|trans }}
                    </a>
                </li>
                {% if app.user %}
                    <li>
                        <a href="{{ path('app_calendar') }}" class="{% if route == 'app_calendar' %}active{% endif %}">
                            {{ 'menu.calendar'|trans }}
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('reservation_mine') }}" class="{% if route == 'reservation_mine' %}active{% endif %}">
                            {{ 'menu.my_reservations'|trans }}
                        </a>
                    </li>
                    {% if is_granted('ROLE_ADMIN_RESSOURCE') %}
                        <li>
                            <a href="{{ path('admin') }}" class="{% if route == 'admin' %}active{% endif %}">
                                {{ 'menu.admin'|trans }}
                            </a>
                        </li>
                    {% endif %}
                {% endif %}
            </ul>
        </div>
        
        <a href="{{ path('app_home') }}" class="flex items-center gap-2 px-2 py-1 text-lg font-bold tracking-tight text-primary hover:opacity-90 transition-opacity">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            <span class="font-bold text-base-content font-outfit">Librebooking</span>
        </a>
    </div>

    {# NAVBAR CENTER: Sleek navigation bar with icons #}
    <div class="navbar-center hidden lg:flex">
        <div class="flex items-center gap-1.5">
            <a href="{{ path('app_home') }}" class="flex items-center gap-2 px-3.5 py-2 rounded-xl text-sm font-medium transition-all hover:bg-base-300 {% if route == 'app_home' %}text-primary bg-primary/10{% else %}text-base-content/80 hover:text-base-content{% endif %}">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                {{ 'menu.home'|trans }}
            </a>
            {% if app.user %}
                <a href="{{ path('app_calendar') }}" class="flex items-center gap-2 px-3.5 py-2 rounded-xl text-sm font-medium transition-all hover:bg-base-300 {% if route == 'app_calendar' %}text-primary bg-primary/10{% else %}text-base-content/80 hover:text-base-content{% endif %}">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    {{ 'menu.calendar'|trans }}
                </a>
                <a href="{{ path('reservation_mine') }}" class="flex items-center gap-2 px-3.5 py-2 rounded-xl text-sm font-medium transition-all hover:bg-base-300 {% if route == 'reservation_mine' %}text-primary bg-primary/10{% else %}text-base-content/80 hover:text-base-content{% endif %}">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
                    {{ 'menu.my_reservations'|trans }}
                </a>
                {% if is_granted('ROLE_ADMIN_RESSOURCE') %}
                    <a href="{{ path('admin') }}" class="flex items-center gap-2 px-3.5 py-2 rounded-xl text-sm font-medium transition-all hover:bg-base-300 {% if route == 'admin' %}text-primary bg-primary/10{% else %}text-base-content/80 hover:text-base-content{% endif %}">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                        {{ 'menu.admin'|trans }}
                    </a>
                {% endif %}
            {% endif %}
        </div>
    </div>

    {# NAVBAR END: Locale, Theme controller, and User Profile #}
    <div class="navbar-end gap-3">
        {# Sleek Language Switcher #}
        <div class="flex items-center gap-1 border border-base-300 rounded-xl p-1 bg-base-200/50">
            <a href="?_locale=fr" class="px-2.5 py-1 text-xs font-bold rounded-lg transition-all {% if app.request.locale == 'fr' %}bg-primary text-primary-content shadow-sm{% else %}text-base-content/60 hover:text-base-content{% endif %}">FR</a>
            <a href="?_locale=en" class="px-2.5 py-1 text-xs font-bold rounded-lg transition-all {% if app.request.locale == 'en' %}bg-primary text-primary-content shadow-sm{% else %}text-base-content/60 hover:text-base-content{% endif %}">EN</a>
        </div>
        
        {# Stimulus-driven dark mode button (no checkbox) #}
        <div data-controller="darkmode" class="flex items-center">
            <button data-action="darkmode#toggle" class="btn btn-ghost btn-circle btn-sm text-base-content/70 hover:text-base-content transition-all hover:bg-base-300" aria-label="Toggle Theme">
                <svg data-darkmode-target="iconLight" class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/></svg>
                <svg data-darkmode-target="iconDark" class="w-4.5 h-4.5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
            </button>
        </div>

        {# Profile Dropdown or Login Button #}
        {% if app.user %}
            <div class="dropdown dropdown-end">
                <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar placeholder hover:bg-base-300 transition-colors">
                    <div class="bg-primary text-primary-content rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm shadow-inner font-outfit">
                        <span>{{ app.user.email|slice(0, 1)|upper }}</span>
                    </div>
                </div>
                <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[50] p-2 shadow-xl bg-base-100 border border-base-300 rounded-xl w-56">
                    <li class="menu-title px-4 py-2 border-b border-base-300 text-xs font-bold text-base-content/50 max-w-full truncate font-outfit">
                        {{ app.user.email }}
                    </li>
                    <li class="mt-1.5">
                        <a href="{{ path('app_profile') }}" class="flex items-center gap-2.5 py-2 rounded-lg text-sm transition-colors hover:bg-base-200">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            {{ 'menu.profile'|trans }}
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('app_logout') }}" class="flex items-center gap-2.5 py-2 rounded-lg text-sm text-error transition-colors hover:bg-error/10">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                            {{ 'menu.logout'|trans }}
                        </a>
                    </li>
                </ul>
            </div>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn btn-primary btn-sm rounded-xl font-bold px-4 hover:opacity-95 transition-opacity">
                {{ 'menu.login'|trans }}
            </a>
        {% endif %}
    </div>
</nav>
