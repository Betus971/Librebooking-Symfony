{% extends 'base.html.twig' %}

{% block title %}{{ 'home.title'|trans }} - Librebooking{% endblock %}

{% block body %}

{# ── Annonces ────────────────────────────────────────────────────────────── #}
{% if announcements is defined and announcements|length > 0 %}
    <div class="mb-8 space-y-3">
        {% for ann in announcements %}
            {% set alertClass = 'alert-info border-info/20 bg-info/5 text-info-content' %}
            {% set icon = '<svg class="h-5 w-5 text-info" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>' %}
            
            {% if ann.priority == 2 %}
                {% set alertClass = 'alert-success border-success/20 bg-success/5 text-success-content' %}
                {% set icon = '<svg class="h-5 w-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>' %}
            {% elseif ann.priority == 3 %}
                {% set alertClass = 'alert-warning border-warning/20 bg-warning/5 text-warning-content' %}
                {% set icon = '<svg class="h-5 w-5 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>' %}
            {% elseif ann.priority == 4 %}
                {% set alertClass = 'alert-error border-error/20 bg-error/5 text-error-content' %}
                {% set icon = '<svg class="h-5 w-5 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>' %}
            {% endif %}

            <div role="alert" class="alert {{ alertClass }} border rounded-xl shadow-sm flex items-start gap-3 p-4">
                <div class="shrink-0 mt-0.5">{{ icon|raw }}</div>
                <div class="font-medium text-sm whitespace-pre-wrap flex-1">{{ ann.message }}</div>
            </div>
        {% endfor %}
    </div>
{% endif %}

{# ── Header / Dashboard Greeting ─────────────────────────────────────────── #}
<div class="mb-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-xl font-bold tracking-tight text-base-content/60 font-outfit uppercase">{{ 'home.dashboard'|trans }}</h1>
            <p class="text-sm text-base-content/50 mt-0.5">{{ 'home.subtitle'|trans }}</p>
        </div>
        {% if app.user %}
            <div class="flex items-center gap-2">
                <a href="{{ path('reservation_new') }}" class="btn btn-primary btn-sm rounded-xl font-bold gap-2 px-4 shadow-sm hover:shadow-md transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                    {{ 'menu.new_reservation'|trans }}
                </a>
            </div>
        {% endif %}
    </div>
    
    <div class="divider opacity-10 my-4"></div>
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mt-4">
        <div>
            {% if app.user %}
                <h2 class="text-2xl font-extrabold text-base-content font-outfit">{{ 'home.greeting'|trans({'%name%': app.user.email|split('@')|first|capitalize}) }}</h2>
            {% else %}
                <h2 class="text-2xl font-extrabold text-base-content font-outfit">{{ 'home.welcome'|trans }}</h2>
            {% endif %}
            <p class="text-xs text-base-content/40 mt-1 font-medium">{{ "now"|date('d/m/Y') }}</p>
        </div>
    </div>
</div>

{# ── Main Layout Grid ────────────────────────────────────────────────────── #}
<div class="flex flex-col lg:flex-row gap-8 items-stretch">

    {# ── Left Sidebar: Next Reservation (Styled like CoachPro upcoming sessions) #}
    {% if next_reservation is not null %}
        <div class="w-full lg:w-1/4 shrink-0">
            <div class="card bg-base-100 border border-base-300 rounded-2xl shadow-sm h-full flex flex-col">
                <div class="card-body p-6 flex flex-col justify-between h-full">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-success/15 text-success">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                            </span>
                            <span class="text-xs font-bold uppercase tracking-wider text-success">{{ 'home.upcoming'|trans }}</span>
                        </div>
                        
                        <h3 class="text-lg font-bold font-outfit text-base-content leading-snug line-clamp-2" title="{{ next_reservation.title }}">
                            {{ next_reservation.title }}
                        </h3>
                        
                        {% set inst = next_reservation.instances|first %}
                        {% if inst %}
                            <div class="mt-4 space-y-2 border-l-2 border-primary/30 pl-3">
                                <p class="text-sm font-semibold text-base-content/85">{{ inst.startDate|date('d/m/Y') }}</p>
                                <p class="text-xs font-medium text-base-content/60">
                                    {{ inst.startDate|date('H:i') }} – {{ inst.endDate|date('H:i') }}
                                </p>
                            </div>
                        {% endif %}
                    </div>
                    
                    <div class="mt-6">
                        <a href="{{ path('reservation_show', {uuid: next_reservation.uuid}) }}" class="btn btn-primary btn-sm w-full rounded-xl font-bold shadow-sm hover:shadow-md transition-all">
                            {{ 'common.view_details'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ── Right Content: Resource Categories Grid ─────────────────────────────── #}
    <div class="flex-grow">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for item in categories %}
                {% set cat = item.category %}
                
                <div class="card bg-base-100 border border-base-300 rounded-2xl shadow-sm flex flex-col justify-between hover:border-primary/30">
                    <div class="card-body p-6 flex flex-col justify-between h-full gap-4">
                        <div>
                            <div class="flex justify-between items-start gap-2">
                                <span class="text-[10px] font-extrabold uppercase tracking-wider text-primary bg-primary/10 px-2 py-0.5 rounded-full border border-primary/20">
                                    {{ item.count }} {{ (item.count > 1 ? 'home.resources_plural' : 'home.resource_singular')|trans }}
                                </span>
                            </div>
                            
                            <h3 class="text-lg font-bold font-outfit text-base-content mt-3 leading-snug">
                                {{ cat.name }}
                            </h3>
                            
                            {% if cat.description %}
                                <p class="text-xs text-base-content/50 mt-2 line-clamp-3 leading-relaxed">
                                    {{ cat.description }}
                                </p>
                            {% endif %}
                        </div>
                        
                        <div class="card-actions justify-end mt-2">
                            <a href="{{ path('app_resource_index', {'category': cat.id, 'view': 'cards'}) }}" class="btn btn-primary btn-sm rounded-xl font-bold w-full sm:w-auto px-4 shadow-sm transition-all">
                                {{ 'home.discover'|trans }}
                            </a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-span-full">
                    <div class="card bg-base-100 border border-base-300 rounded-2xl p-10 text-center">
                        <div class="max-w-md mx-auto py-4">
                            <h3 class="text-xl font-bold font-outfit text-base-content">{{ 'home.empty_title'|trans }}</h3>
                            <p class="text-sm text-base-content/50 mt-2">{{ 'home.empty_text'|trans }}</p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

{% endblock %}
