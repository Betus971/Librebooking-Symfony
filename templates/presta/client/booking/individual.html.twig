{% extends 'base.html.twig' %}

{% block title %}{{ 'presta.book_appointment'|trans }} : {{ service.libelle }}{% endblock %}

{% macro slot(c, service, jourLabel) %}
    <form method="post" action="{{ path('app_presta_client_booking_individual_book', {'id': service.id}) }}" class="slot"
          onsubmit="return confirm('{{ 'presta.confirm_appointment'|trans({'%time%': c.start|date('H:i')})|e('js') }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('book_individual' ~ service.id) }}">
        <input type="hidden" name="time" value="{{ c.startStr }}">
        <button type="submit" class="slot__btn">{{ c.start|date('H:i') }}</button>
    </form>
{% endmacro %}
{% import _self as ui %}

{% block stylesheets %}
{{ parent() }}
<style>
    .slot-picker { display:grid; grid-template-columns:repeat(auto-fill,minmax(92px,1fr)); gap:.5rem; }
    .slot { margin:0; }
    .slot__btn { width:100%; min-height:2.75rem; cursor:pointer; border:1px solid #18753c; background:rgba(24,117,60,.12); color:#18753c; border-radius:6px; font-size:.9375rem; font-weight:600; transition:filter .15s; }
    .slot__btn:hover { filter:brightness(.95); }
    .slot-group-title { font-size:.8125rem; font-weight:700; text-transform:uppercase; letter-spacing:.03em; opacity:.6; margin:1.25rem 0 .5rem; }
    .week-scroll { overflow-x:auto; }
    .week-days { display:grid; grid-template-columns:repeat(7,minmax(116px,1fr)); gap:.5rem; min-width:720px; }
    .week-day { border:1px solid var(--fallback-b3,#ddd); border-radius:6px; display:flex; flex-direction:column; overflow:hidden; }
    .week-day__head { text-align:center; padding:.5rem .25rem; font-weight:700; font-size:.8125rem; background:var(--fallback-b2,#f5f5fe); }
    .week-day__head small { display:block; font-weight:400; opacity:.6; }
    .week-day__slots { display:flex; flex-direction:column; gap:.35rem; padding:.5rem; }
    .week-day__slots .slot__btn { min-height:2.25rem; font-size:.875rem; }
    .week-day__empty { text-align:center; opacity:.5; font-size:.8125rem; padding:1rem 0; }
</style>
{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto">
    <div class="text-sm breadcrumbs mb-6">
        <ul>
            <li><a href="{{ path('app_presta_client_prestataire_index') }}">{{ 'presta.directory'|trans }}</a></li>
            <li><a href="{{ path('app_presta_client_prestataire_show', {'id': service.prestataire.id}) }}">{{ service.prestataire.prenom }} {{ service.prestataire.nom }}</a></li>
            <li>{{ service.libelle }}</li>
        </ul>
    </div>

    <h1 class="text-2xl font-bold mb-1">{{ 'presta.book_title'|trans({'%service%': service.libelle}) }}</h1>
    <p class="text-base-content/60 mb-4">{{ 'presta.duration_select'|trans({'%min%': service.dureeMinutes}) }}</p>

    <div role="tablist" class="tabs tabs-boxed w-fit mb-4">
        <a role="tab" href="{{ path('app_presta_client_booking_individual', {'id': service.id, 'date': currentDate|date('Y-m-d'), 'view': 'day'}) }}" class="tab {{ view == 'day' ? 'tab-active' : '' }}">{{ 'presta.view_by_day'|trans }}</a>
        <a role="tab" href="{{ path('app_presta_client_booking_individual', {'id': service.id, 'date': currentDate|date('Y-m-d'), 'view': 'week'}) }}" class="tab {{ view == 'week' ? 'tab-active' : '' }}">{{ 'presta.view_by_week'|trans }}</a>
    </div>

    {% if view == 'day' %}
    <div class="card bg-base-100 border border-base-300 shadow-sm p-4">
        <div class="flex items-center justify-between mb-3 gap-2">
            <a href="{{ path('app_presta_client_booking_individual', {'id': service.id, 'date': prevDate|date('Y-m-d'), 'view': 'day'}) }}" class="btn btn-ghost btn-sm">{{ 'presta.prev_day'|trans }}</a>
            <h2 class="font-semibold text-center">{{ currentDate|format_datetime(pattern='EEEE d MMMM y', locale=app.request.locale)|capitalize }}</h2>
            <a href="{{ path('app_presta_client_booking_individual', {'id': service.id, 'date': nextDate|date('Y-m-d'), 'view': 'day'}) }}" class="btn btn-ghost btn-sm">{{ 'presta.next_day'|trans }}</a>
        </div>

        {% if creneaux|length == 0 %}
            <div class="alert alert-info">
                <span>{{ 'presta.no_slot_day'|trans }}</span>
            </div>
        {% else %}
            {% set matin = creneaux|filter(c => (c.start|date('G')) < 12) %}
            {% set aprem = creneaux|filter(c => (c.start|date('G')) >= 12) %}
            <p class="text-sm opacity-60 mb-1">{{ 'presta.slots_available'|trans({'%count%': creneaux|length}) }}</p>
            {% if matin|length > 0 %}
                <h3 class="slot-group-title">{{ 'presta.morning'|trans }}</h3>
                <div class="slot-picker">{% for c in matin %}{{ ui.slot(c, service) }}{% endfor %}</div>
            {% endif %}
            {% if aprem|length > 0 %}
                <h3 class="slot-group-title">{{ 'presta.afternoon'|trans }}</h3>
                <div class="slot-picker">{% for c in aprem %}{{ ui.slot(c, service) }}{% endfor %}</div>
            {% endif %}
        {% endif %}
    </div>
    {% else %}
    <div class="card bg-base-100 border border-base-300 shadow-sm p-4">
        <div class="flex items-center justify-between mb-3 gap-2">
            <a href="{{ path('app_presta_client_booking_individual', {'id': service.id, 'date': prevWeek|date('Y-m-d'), 'view': 'week'}) }}" class="btn btn-ghost btn-sm">{{ 'presta.prev_week'|trans }}</a>
            <h2 class="font-semibold text-center">{{ 'presta.week_range'|trans({'%start%': daysOfWeek[0]|date('d/m'), '%end%': daysOfWeek[6]|date('d/m/Y')}) }}</h2>
            <a href="{{ path('app_presta_client_booking_individual', {'id': service.id, 'date': nextWeek|date('Y-m-d'), 'view': 'week'}) }}" class="btn btn-ghost btn-sm">{{ 'presta.next_week'|trans }}</a>
        </div>

        {% set totalCreneaux = 0 %}
        {% for dayCreneaux in creneauxByDay %}{% set totalCreneaux = totalCreneaux + dayCreneaux|length %}{% endfor %}

        {% if totalCreneaux == 0 %}
            <div class="alert alert-info"><span>{{ 'presta.no_slot_week'|trans }}</span></div>
        {% else %}
            <div class="week-scroll">
                <div class="week-days">
                    {% for day in daysOfWeek %}
                        {% set dayCreneaux = creneauxByDay[day|date('Y-m-d')] %}
                        <div class="week-day">
                            <div class="week-day__head">{{ day|format_datetime(pattern='EEE', locale=app.request.locale)|capitalize }}<small>{{ day|date('d/m') }}{% if dayCreneaux|length > 0 %} · {{ dayCreneaux|length }}{% endif %}</small></div>
                            {% if dayCreneaux|length > 0 %}
                                <div class="week-day__slots">{% for c in dayCreneaux %}{{ ui.slot(c, service) }}{% endfor %}</div>
                            {% else %}
                                <div class="week-day__empty">—</div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
    {% endif %}
</div>
{% endblock %}
