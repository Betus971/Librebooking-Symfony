{% extends 'base.html.twig' %}

{% block title %}Prendre rendez-vous — par catégorie{% endblock %}

{% block body %}
<div class="container mx-auto px-4 mt-8 mb-16">
    <div class="text-sm breadcrumbs mb-6">
        <ul>
            <li><a href="{{ path('app_presta_dashboard') }}">Accueil Presta</a></li>
            <li>Prendre rendez-vous</li>
        </ul>
    </div>

    <div class="hero bg-gradient-to-br from-primary to-primary-focus text-primary-content rounded-3xl mb-12 shadow-xl overflow-hidden relative">
        <div class="absolute -top-12 -right-12 w-72 h-72 bg-white opacity-10 rounded-full blur-2xl"></div>
        <div class="hero-content text-left w-full py-12 px-8 flex-col items-start">
            <h1 class="text-4xl font-bold mb-4">Prendre rendez-vous</h1>
            <p class="text-lg max-w-2xl opacity-90">Choisissez une catégorie pour découvrir les professionnels et les prestations disponibles sur le site.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for categorie in categories %}
            <div class="card bg-base-100 shadow-md hover:shadow-xl transition-all duration-300 border-t-4 border-primary hover:-translate-y-1">
                <div class="card-body">
                    <h2 class="card-title text-xl font-bold">
                        <a href="{{ path('app_presta_client_categorie_show', {'id': categorie.id}) }}" class="hover:text-primary transition-colors">
                            {{ categorie.nom }}
                        </a>
                    </h2>
                    <p class="text-base-content/70 flex-grow my-4">{{ categorie.description|default('Voir les prestations de cette catégorie.') }}</p>
                    <div class="card-actions justify-start">
                        <a href="{{ path('app_presta_client_categorie_show', {'id': categorie.id}) }}" class="text-primary font-semibold flex items-center gap-2 group">
                            Voir les professionnels 
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-span-full">
                <div class="alert alert-info shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <div>
                        <h3 class="font-bold">Aucune catégorie</h3>
                        <div class="text-sm">Aucune catégorie de prestations n'est disponible pour le moment.</div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
