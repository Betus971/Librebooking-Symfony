{% extends 'base.html.twig' %}

{% block title %}{{ 'presta.title'|trans }} — {{ 'presta.book_appointment'|trans }}{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto">
    <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-base-content">{{ 'presta.title'|trans }}</h1>
        <p class="text-base-content/60 mt-1">{{ 'presta.dashboard_subtitle'|trans }}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <a href="{{ path('app_presta_client_prestataire_index') }}" class="card bg-base-100 border border-base-300 shadow-sm hover:border-primary/40 transition-all">
            <div class="card-body">
                <h2 class="card-title text-primary">{{ 'presta.book_appointment'|trans }}</h2>
                <p class="text-sm text-base-content/70">{{ 'presta.book_card_desc'|trans }}</p>
                <div class="card-actions justify-end"><span class="badge badge-info">{{ 'presta.badge_user'|trans }}</span></div>
            </div>
        </a>

        <a href="{{ path('app_presta_provider_profile_edit') }}" class="card bg-base-200 border border-base-300 shadow-sm hover:border-primary/40 transition-all">
            <div class="card-body">
                <h2 class="card-title">{{ 'presta.provider_space'|trans }}</h2>
                <p class="text-sm text-base-content/70">{{ 'presta.provider_card_desc'|trans }}</p>
                <div class="card-actions justify-end"><span class="badge badge-secondary">{{ 'presta.badge_pro'|trans }}</span></div>
            </div>
        </a>
    </div>
</div>
{% endblock %}
