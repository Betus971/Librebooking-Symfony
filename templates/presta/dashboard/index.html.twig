{% extends 'base.html.twig' %}

{% block title %}Prestations — Tableau de bord{% endblock %}

{% block body %}
<div class="container mx-auto px-4 mt-8 mb-16">

    <div class="hero bg-gradient-to-br from-primary to-primary-focus text-primary-content rounded-3xl mb-12 shadow-xl overflow-hidden relative">
        <div class="absolute -top-12 -right-12 w-72 h-72 bg-white opacity-10 rounded-full blur-2xl"></div>
        <div class="hero-content text-left w-full py-12 px-8 flex-col items-start">
            <h1 class="text-4xl font-bold mb-4">Prestations & Services</h1>
            <p class="text-lg max-w-2xl opacity-90">
                Bienvenue dans le module de prise de rendez-vous. Que vous cherchiez un professionnel ou que vous gériez votre activité, tout se passe ici.
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        {# Action principale : prendre rendez-vous #}
        <div class="card bg-base-100 shadow-xl hover:-translate-y-1 transition-transform duration-300 border-l-4 border-primary">
            <div class="card-body flex flex-col h-full">
                <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-3xl mb-4 bg-primary/10 text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
                <h2 class="card-title text-2xl font-bold mb-2">
                    <a href="{{ path('app_presta_client_categorie_index') }}" class="hover:text-primary transition-colors">
                        Prendre rendez-vous
                    </a>
                </h2>
                <p class="text-base-content/70 flex-grow mb-6">
                    Parcourez l'annuaire des professionnels et réservez un créneau (rendez-vous individuel ou séance de groupe).
                </p>
                <div class="card-actions justify-between items-center mt-auto">
                    <div class="badge badge-primary badge-outline font-semibold uppercase tracking-wider text-xs p-3">Espace Utilisateur</div>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                </div>
            </div>
        </div>

        {# Espace prestataire — réservé aux utilisateurs désignés "Prestataire" #}
        {% if is_granted('ROLE_PRESTATAIRE') %}
        <div class="card bg-base-100 shadow-xl hover:-translate-y-1 transition-transform duration-300 border-l-4 border-secondary">
            <div class="card-body flex flex-col h-full">
                <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-3xl mb-4 bg-secondary/10 text-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                </div>
                <h2 class="card-title text-2xl font-bold mb-2">
                    <a href="{{ path('app_presta_provider_dashboard_index') }}" class="hover:text-secondary transition-colors">
                        Gérer mon activité
                    </a>
                </h2>
                <p class="text-base-content/70 flex-grow mb-6">
                    Configurez votre profil, votre catalogue de services, vos disponibilités et gérez vos séances avec vos clients.
                </p>
                <div class="card-actions justify-between items-center mt-auto">
                    <div class="badge badge-secondary badge-outline font-semibold uppercase tracking-wider text-xs p-3">Espace Professionnel</div>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                </div>
            </div>
        </div>
        {% endif %}

    </div>
</div>
{% endblock %}
