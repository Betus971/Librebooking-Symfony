{% extends 'base.html.twig' %}

{% block title %}Prestations — Tableau de bord{% endblock %}

{% block body %}
<div class="container mx-auto px-4 mt-8 mb-16">

    {# En-tête (Hero) #}
    <div class="relative overflow-hidden rounded-[2rem] bg-indigo-600 shadow-2xl mb-12">
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-white opacity-10 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-black/20 to-transparent"></div>
        
        <div class="relative z-10 px-8 py-16 md:px-16 flex flex-col items-start">
            <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-6 tracking-tight">Prestations & Services</h1>
            <p class="text-lg md:text-xl text-indigo-100 max-w-2xl leading-relaxed">
                Bienvenue dans le module de prise de rendez-vous. Que vous cherchiez un professionnel ou que vous gériez votre activité, tout se passe ici.
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        {# Action principale : prendre rendez-vous #}
        <div class="group relative card bg-base-100 shadow-lg hover:shadow-2xl transition-all duration-300 border border-base-200 overflow-hidden">
            <div class="absolute left-0 top-0 w-1 h-full bg-primary transition-all duration-300 group-hover:w-full group-hover:opacity-5"></div>
            
            <div class="card-body relative z-10 flex flex-col h-full p-8">
                <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-3xl mb-6 bg-primary/10 text-primary group-hover:scale-110 group-hover:-rotate-3 transition-transform duration-300">
                    <i class="fa-regular fa-calendar-check text-3xl"></i>
                </div>
                <h2 class="card-title text-2xl font-bold mb-3 text-base-content">
                    <a href="{{ path('app_presta_client_categorie_index') }}" class="before:absolute before:inset-0">
                        Prendre rendez-vous
                    </a>
                </h2>
                <p class="text-base-content/70 flex-grow mb-8 text-lg">
                    Parcourez l'annuaire des professionnels et réservez un créneau (rendez-vous individuel ou séance de groupe).
                </p>
                <div class="flex justify-between items-center mt-auto">
                    <span class="badge badge-primary badge-outline font-semibold uppercase tracking-wider text-xs px-3 py-4 rounded-full">Espace Utilisateur</span>
                    <i class="fa-solid fa-arrow-right text-primary opacity-70 group-hover:opacity-100 group-hover:translate-x-1 transition-all"></i>
                </div>
            </div>
        </div>

        {# Espace prestataire — réservé aux utilisateurs désignés "Prestataire" #}
        {% if is_granted('ROLE_PRESTATAIRE') %}
        <div class="group relative card bg-base-100 shadow-lg hover:shadow-2xl transition-all duration-300 border border-base-200 overflow-hidden">
            <div class="absolute left-0 top-0 w-1 h-full bg-secondary transition-all duration-300 group-hover:w-full group-hover:opacity-5"></div>
            
            <div class="card-body relative z-10 flex flex-col h-full p-8">
                <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-3xl mb-6 bg-secondary/10 text-secondary group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300">
                    <i class="fa-solid fa-briefcase text-3xl"></i>
                </div>
                <h2 class="card-title text-2xl font-bold mb-3 text-base-content">
                    <a href="{{ path('app_presta_provider_dashboard_index') }}" class="before:absolute before:inset-0">
                        Gérer mon activité
                    </a>
                </h2>
                <p class="text-base-content/70 flex-grow mb-8 text-lg">
                    Configurez votre profil, votre catalogue de services, vos disponibilités et gérez vos séances avec vos clients.
                </p>
                <div class="flex justify-between items-center mt-auto">
                    <span class="badge badge-secondary badge-outline font-semibold uppercase tracking-wider text-xs px-3 py-4 rounded-full">Espace Professionnel</span>
                    <i class="fa-solid fa-arrow-right text-secondary opacity-70 group-hover:opacity-100 group-hover:translate-x-1 transition-all"></i>
                </div>
            </div>
        </div>
        {% endif %}

    </div>
</div>
{% endblock %}
