{% extends 'base.html.twig' %}

{% block title %}{{ is_edit ? 'Modifier' : 'Ajouter' }} une plage horaire{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto">
    <div class="text-sm breadcrumbs mb-6">
        <ul>
            <li><a href="{{ path('app_presta_provider_schedule_index') }}">Mes disponibilités</a></li>
            <li>{{ is_edit ? 'Modifier' : 'Ajouter' }}</li>
        </ul>
    </div>

    <h1 class="text-2xl font-bold mb-4">{{ is_edit ? 'Modifier' : 'Ajouter' }} une plage horaire</h1>

    <div class="card bg-base-100 border border-base-300 shadow-sm">
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_row(form.jourSemaine, {attr:{class:'select select-bordered w-full'}}) }}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>{{ form_row(form.heureDebut, {attr:{class:'input input-bordered w-full'}}) }}</div>
                <div>{{ form_row(form.heureFin, {attr:{class:'input input-bordered w-full'}}) }}</div>
            </div>
            <div class="flex gap-3 mt-4">
                <button type="submit" class="btn btn-primary">{{ is_edit ? 'Enregistrer' : 'Créer' }}</button>
                <a href="{{ path('app_presta_provider_schedule_index') }}" class="btn btn-ghost">Annuler</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
