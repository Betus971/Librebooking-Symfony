{% extends 'base.html.twig' %}

{% block title %}{{ 'presta.my_profile'|trans }}{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto">
    <div class="text-sm breadcrumbs mb-6">
        <ul>
            <li><a href="{{ path('app_presta_dashboard') }}">{{ 'presta.home'|trans }}</a></li>
            <li>{{ 'presta.my_profile_short'|trans }}</li>
        </ul>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <aside class="md:col-span-1">{{ include('presta/provider/_sidemenu.html.twig', { current_menu: 'profile' }) }}</aside>
        <div class="md:col-span-3">
            <h1 class="text-2xl font-bold mb-1">{{ 'presta.my_profile'|trans }}</h1>
            <p class="text-sm text-base-content/60 mb-4">{{ 'presta.profile_subtitle'|trans }}</p>

            <div class="card bg-base-100 border border-base-300 shadow-sm">
                <div class="card-body">
                    {{ form_start(form) }}
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>{{ form_row(form.nom, {attr:{class:'input input-bordered w-full'}}) }}</div>
                        <div>{{ form_row(form.prenom, {attr:{class:'input input-bordered w-full'}}) }}</div>
                        <div class="md:col-span-2">{{ form_row(form.description, {attr:{class:'textarea textarea-bordered w-full', rows:4}}) }}</div>
                        <div class="md:col-span-2">{{ form_row(form.photo, {attr:{class:'input input-bordered w-full'}}) }}</div>
                        <div class="md:col-span-2">{{ form_row(form.isActive, {attr:{class:'toggle toggle-primary'}}) }}</div>
                    </div>
                    <div class="mt-6">
                        <button type="submit" class="btn btn-primary">{{ 'presta.save_profile'|trans }}</button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
