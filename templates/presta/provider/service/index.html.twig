{% extends 'base.html.twig' %}

{% block title %}Mes prestations{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="text-sm breadcrumbs mb-6">
        <ul>
            <li><a href="{{ path('app_presta_dashboard') }}">Accueil Presta</a></li>
            <li>Mes Prestations</li>
        </ul>
    </div>

    <div class="flex flex-col md:flex-row gap-8">
        <div class="w-full md:w-1/4">
            {{ include('presta/provider/_sidemenu.html.twig', { current_menu: 'service' }) }}
        </div>
        <div class="w-full md:w-3/4">
            <div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
                <h1 class="text-3xl font-bold">Mon Catalogue de Prestations</h1>
                <a href="{{ path('app_presta_provider_service_new') }}" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    Ajouter une prestation
                </a>
            </div>

            <div class="overflow-x-auto bg-base-100 shadow-xl rounded-box">
                <table class="table w-full">
                    <thead>
                        <tr>
                            <th>Prestation</th>
                            <th>Type</th>
                            <th>Durée</th>
                            <th>Capacité</th>
                            <th>Statut</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for service in services %}
                        <tr class="hover">
                            <td>
                                <strong class="font-semibold">{{ service.libelle }}</strong>
                            </td>
                            <td>
                                {% if service.type == 'INDIVIDUEL' %}
                                    <span class="badge badge-info gap-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                                        Individuel
                                    </span>
                                {% else %}
                                    <span class="badge badge-secondary gap-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                                        Groupe
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="flex items-center gap-1 text-base-content/70">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    {{ service.dureeMinutes }} min
                                </div>
                            </td>
                            <td>{{ service.capaciteMax }} pers.</td>
                            <td>
                                <input type="checkbox" class="toggle toggle-sm service-toggle" id="toggle-{{ service.id }}" data-id="{{ service.id }}" {% if service.isActive %}checked{% endif %} />
                            </td>
                            <td class="text-right">
                                <div class="join justify-end">
                                    <a href="{{ path('app_presta_provider_service_edit', {'id': service.id}) }}" class="btn btn-sm btn-ghost join-item" title="Modifier">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                    </a>
                                    <form method="post" action="{{ path('app_presta_provider_service_delete', {'id': service.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette prestation ?');" style="display: inline-block;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ service.id) }}">
                                        <button class="btn btn-sm btn-ghost text-error join-item" title="Supprimer">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-12 text-base-content/60">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto mb-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
                                <p class="text-lg">Vous ne proposez encore aucune prestation.</p>
                                <a href="{{ path('app_presta_provider_service_new') }}" class="btn btn-primary mt-4">Créer ma première prestation</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.service-toggle').forEach(toggle => {
                toggle.addEventListener('change', async (e) => {
                    const isActive = e.target.checked;
                    const serviceId = e.target.dataset.id;
                    const url = `/presta/provider/service/${serviceId}/toggle-active`;

                    try {
                        const response = await fetch(url, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: JSON.stringify({ active: isActive })
                        });

                        if (!response.ok) {
                            throw new Error('Erreur lors de la mise à jour');
                        }
                    } catch (error) {
                        console.error(error);
                        alert('Impossible de modifier le statut de cette prestation.');
                        e.target.checked = !isActive; // Revert
                    }
                });
            });
        });
    </script>
{% endblock %}
