{% extends 'base.html.twig' %}

{% block title %}{{ is_edit ? 'Modifier' : 'Planifier' }} une séance{% endblock %}

{% block body %}
<div class="container mx-auto px-4 mt-8 mb-16">
    <div class="breadcrumbs text-sm mb-6">
        <ul>
            <li><a href="{{ path('app_presta_provider_session_index') }}">Mes séances</a></li>
            <li>{{ is_edit ? 'Modifier' : 'Planifier' }}</li>
        </ul>
    </div>

    <div class="flex justify-center">
        <div class="w-full max-w-2xl">
            <h1 class="text-3xl font-bold mb-6">{{ is_edit ? 'Modifier la séance' : 'Planifier une séance' }}</h1>

            <div class="card bg-base-100 shadow-xl border border-base-200">
                <div class="card-body">
                    {{ form_start(form) }}
                    
                    <div class="mb-4">
                        {{ form_row(form.service) }}
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                        <div>
                            {{ form_row(form.dateDebut) }}
                        </div>
                        <div>
                            {{ form_row(form.dateFin) }}
                        </div>
                    </div>

                    <div class="card-actions justify-start mt-6">
                        <button type="submit" class="btn btn-primary">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            {{ is_edit ? 'Enregistrer' : 'Créer la séance' }}
                        </button>
                        <a href="{{ path('app_presta_provider_session_index') }}" class="btn btn-ghost">Annuler</a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
