{% extends 'base.html.twig' %}

{% block title %}Mes séances de groupe{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto">
    <div class="text-sm breadcrumbs mb-6">
        <ul>
            <li><a href="{{ path('app_presta_dashboard') }}">Accueil Presta</a></li>
            <li>Mes séances</li>
        </ul>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <aside class="md:col-span-1">{{ include('presta/provider/_sidemenu.html.twig', { current_menu: 'session' }) }}</aside>
        <div class="md:col-span-3">
            <div class="flex items-center justify-between mb-2">
                <h1 class="text-2xl font-bold">Mes séances de groupe</h1>
                <a href="{{ path('app_presta_provider_session_new') }}" class="btn btn-primary btn-sm">+ Planifier</a>
            </div>
            <p class="text-sm text-base-content/60 mb-4">Gérez ici les dates précises pour les prestations de type « Groupe ».</p>

            <div class="card bg-base-100 border border-base-300 shadow-sm">
                <div class="overflow-x-auto">
                    <table class="table">
                        <thead><tr><th>Date</th><th>Horaire</th><th>Prestation</th><th>Inscrits</th><th class="text-right">Actions</th></tr></thead>
                        <tbody>
                        {% for session in sessions %}
                            <tr>
                                <td class="font-semibold">{{ session.dateDebut|date('d/m/Y') }}</td>
                                <td>{{ session.dateDebut|date('H:i') }} - {{ session.dateFin|date('H:i') }}</td>
                                <td>{{ session.service.libelle }}</td>
                                <td>
                                    {% set restantes = session.service.capaciteMax - session.nbInscrits %}
                                    <span class="badge badge-sm {{ restantes == 0 ? 'badge-error' : 'badge-info' }}">{{ session.nbInscrits }} / {{ session.service.capaciteMax }}</span>
                                </td>
                                <td class="text-right">
                                    <div class="flex justify-end gap-1">
                                        <a href="{{ path('app_presta_provider_session_edit', {'id': session.id}) }}" class="btn btn-ghost btn-xs" title="Modifier">✎</a>
                                        <form method="post" action="{{ path('app_presta_provider_session_delete', {'id': session.id}) }}" onsubmit="return confirm('Annuler cette séance ? Des personnes sont peut-être inscrites.');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ session.id) }}">
                                            <button class="btn btn-ghost btn-xs text-error" title="Supprimer">🗑</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="text-center py-8 text-base-content/60">
                                Aucune séance planifiée.<br>
                                <a href="{{ path('app_presta_provider_session_new') }}" class="btn btn-sm btn-primary mt-3">Créer une séance</a>
                            </td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
