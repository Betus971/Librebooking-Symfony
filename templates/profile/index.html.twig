{% extends 'base.html.twig' %}

{% block title %}Mon Compte - Librebooking{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto py-12 w-full flex-grow">
    
    <div class="md:flex md:items-center md:justify-between mb-10">
        <div class="min-w-0 flex-1">
            <h2 class="text-3xl font-extrabold leading-tight text-base-content tracking-tight">
                {{ 'profile.title'|trans }}
            </h2>
            <p class="mt-2 text-sm text-base-content/70">{{ 'profile.description'|trans }}</p>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="mb-8">
            <div class="alert alert-success shadow-sm">
                <svg class="h-6 w-6 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <div>
                    <h3 class="font-bold">Succès</h3>
                    <div class="text-sm">{{ message }}</div>
                </div>
            </div>
        </div>
    {% endfor %}

    <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="card-body px-4 py-8 sm:p-10">
            {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}
                
                <div class="grid grid-cols-1 gap-y-6 gap-x-8 sm:grid-cols-6">
                    <div class="sm:col-span-3 form-control w-full">
                        {{ form_label(form.fname, 'Prénom', {'label_attr': {'class': 'label font-medium text-base-content'}}) }}
                        {{ form_widget(form.fname, {'attr': {'class': 'input input-bordered w-full'}}) }}
                        {% if form.fname.vars.errors|length > 0 %}
                            <label class="label"><span class="label-text-alt text-error">{{ form_errors(form.fname) }}</span></label>
                        {% endif %}
                    </div>

                    <div class="sm:col-span-3 form-control w-full">
                        {{ form_label(form.lname, 'Nom', {'label_attr': {'class': 'label font-medium text-base-content'}}) }}
                        {{ form_widget(form.lname, {'attr': {'class': 'input input-bordered w-full'}}) }}
                        {% if form.lname.vars.errors|length > 0 %}
                            <label class="label"><span class="label-text-alt text-error">{{ form_errors(form.lname) }}</span></label>
                        {% endif %}
                    </div>

                    <div class="sm:col-span-6 form-control w-full">
                        {{ form_label(form.email, 'Adresse email', {'label_attr': {'class': 'label font-medium text-base-content'}}) }}
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <svg class="h-5 w-5 text-base-content/50" viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                                    <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                                </svg>
                            </div>
                            {{ form_widget(form.email, {'attr': {'class': 'input input-bordered w-full pl-11 bg-base-200 cursor-not-allowed'}}) }}
                        </div>
                        <label class="label">
                            <span class="label-text-alt text-base-content/60 flex items-center">
                                <svg class="w-4 h-4 mr-1.5 inline text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                Votre adresse e-mail est utilisée pour vous connecter et ne peut être modifiée ici.
                            </span>
                        </label>
                    </div>

                    <div class="sm:col-span-3 form-control w-full">
                        {{ form_label(form.phone, 'Téléphone', {'label_attr': {'class': 'label font-medium text-base-content'}}) }}
                        {{ form_widget(form.phone, {'attr': {'class': 'input input-bordered w-full'}}) }}
                        {% if form.phone.vars.errors|length > 0 %}
                            <label class="label"><span class="label-text-alt text-error">{{ form_errors(form.phone) }}</span></label>
                        {% endif %}
                    </div>

                    <div class="sm:col-span-3 form-control w-full">
                        {{ form_label(form.organization, 'Organisation / Entreprise', {'label_attr': {'class': 'label font-medium text-base-content'}}) }}
                        {{ form_widget(form.organization, {'attr': {'class': 'input input-bordered w-full'}}) }}
                        {% if form.organization.vars.errors|length > 0 %}
                            <label class="label"><span class="label-text-alt text-error">{{ form_errors(form.organization) }}</span></label>
                        {% endif %}
                    </div>

                    <div class="sm:col-span-3 form-control w-full">
                        {{ form_label(form.position, 'Poste / Fonction', {'label_attr': {'class': 'label font-medium text-base-content'}}) }}
                        {{ form_widget(form.position, {'attr': {'class': 'input input-bordered w-full'}}) }}
                        {% if form.position.vars.errors|length > 0 %}
                            <label class="label"><span class="label-text-alt text-error">{{ form_errors(form.position) }}</span></label>
                        {% endif %}
                    </div>

                    <div class="sm:col-span-3 form-control w-full">
                        {{ form_label(form.timezone, 'Fuseau horaire', {'label_attr': {'class': 'label font-medium text-base-content'}}) }}
                        {{ form_widget(form.timezone, {'attr': {'class': 'select select-bordered w-full'}}) }}
                        {% if form.timezone.vars.errors|length > 0 %}
                            <label class="label"><span class="label-text-alt text-error">{{ form_errors(form.timezone) }}</span></label>
                        {% endif %}
                    </div>
                </div>

                <div class="mt-10 pt-6 border-t border-base-200 card-actions justify-end">
                    <button type="submit" class="btn btn-primary">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        {{ 'profile.save'|trans }}
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
