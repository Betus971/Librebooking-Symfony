{% extends 'base.html.twig' %}
{% block title %}{{ 'register.title'|trans }} - Librebooking{% endblock %}
{% block body %}
<div class="min-h-[80vh] flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md text-center">
        <div class="flex justify-center mb-6">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center">
                <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>
            </div>
        </div>
        <h2 class="text-3xl font-extrabold text-base-content tracking-tight font-outfit">{{ 'register.title'|trans }}</h2>
        <p class="mt-2 text-sm text-base-content/70">
            {{ 'register.have_account'|trans }}
            <a href="{{ path('app_login') }}" class="link link-primary font-medium">{{ 'register.login_link'|trans }}</a>
        </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="card bg-base-100 shadow-xl border border-base-300">
            <div class="card-body sm:p-10">
                <form class="space-y-5" method="post" action="{{ path('app_register') }}">
                    {% if errors is defined and errors|length > 0 %}
                        <div class="alert alert-error border border-error/20 bg-error/5 text-error-content shadow-sm p-4 rounded-xl">
                            <div class="flex flex-col gap-1.5">
                                {% for error in errors %}
                                    <div class="flex items-center gap-2 text-sm">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-4 w-4" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                        <span>{{ error }}</span>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <div class="grid grid-cols-2 gap-4">
                        <div class="form-control w-full">
                            <label for="fname" class="label"><span class="label-text font-semibold text-base-content/80">{{ 'register.fname'|trans }}</span></label>
                            <input type="text" name="fname" id="fname" value="{{ fname }}" class="input input-bordered input-sm rounded-xl w-full" placeholder="John" required autofocus>
                        </div>
                        <div class="form-control w-full">
                            <label for="lname" class="label"><span class="label-text font-semibold text-base-content/80">{{ 'register.lname'|trans }}</span></label>
                            <input type="text" name="lname" id="lname" value="{{ lname }}" class="input input-bordered input-sm rounded-xl w-full" placeholder="Doe" required>
                        </div>
                    </div>

                    <div class="form-control w-full">
                        <label for="email" class="label"><span class="label-text font-semibold text-base-content/80">{{ 'register.email'|trans }}</span></label>
                        <input type="email" name="email" id="email" value="{{ email }}" class="input input-bordered input-sm rounded-xl w-full" placeholder="vous@exemple.com" required>
                    </div>

                    <div class="form-control w-full">
                        <label for="password" class="label"><span class="label-text font-semibold text-base-content/80">{{ 'register.password'|trans }}</span></label>
                        <input type="password" name="password" id="password" class="input input-bordered input-sm rounded-xl w-full" placeholder="••••••••" minlength="6" required>
                        <label class="label mt-1"><span class="label-text-alt text-base-content/40">{{ 'register.password_hint'|trans }}</span></label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-sm rounded-xl w-full mt-4 font-bold">{{ 'register.submit'|trans }}</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
