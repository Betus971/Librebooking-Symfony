{% extends 'base.html.twig' %}
{% block title %}Mes réservations - Librebooking{% endblock %}
{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    {# --- EN-TÊTE --- #}
    <div class="md:flex md:items-center md:justify-between mb-8">
        <div class="flex-1 min-w-0">
            <h1 class="text-2xl font-bold leading-7 text-slate-900 sm:text-3xl sm:truncate">
                Mes réservations
            </h1>
            <p class="mt-2 text-sm text-slate-500">
                Suivez l'état de vos demandes de ressources.
            </p>
        </div>
        <div class="mt-4 flex md:mt-0 md:ml-4 gap-3">
            <a href="{{ path('reservation_index') }}" class="inline-flex items-center px-4 py-2 border border-slate-300 rounded-md shadow-sm text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                <svg class="-ml-1 mr-2 h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Retour
            </a>
            <a href="{{ path('reservation_new') }}" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Nouvelle demande
            </a>
        </div>
    </div>

    {# --- CONTENU --- #}
    {% if series is empty %}
        <div class="bg-blue-50 border-l-4 border-blue-400 p-4 rounded-r-md">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" /></svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-blue-800">Aucune réservation</h3>
                    <div class="mt-2 text-sm text-blue-700">
                        <p>Vous n'avez effectué aucune demande de réservation pour le moment.</p>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="bg-white shadow-sm ring-1 ring-slate-200 rounded-2xl overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200">
                    <thead class="bg-slate-50">
                        <tr>
                            <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-slate-900 sm:pl-6 w-1/3">Titre de la réservation</th>
                            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900">Ressource(s)</th>
                            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900">Prochaine séance</th>
                            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900">Statut</th>
                            <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 bg-white">
                        {% for s in series %}
                            <tr class="hover:bg-slate-50 transition-colors">
                                {# TITRE & TYPE #}
                                <td class="py-4 pl-4 pr-3 text-sm sm:pl-6">
                                    <a href="{{ path('reservation_show', {'uuid': s.uuid}) }}" class="font-medium text-indigo-600 hover:text-indigo-900">
                                        {{ s.title|default('Série #' ~ s.id) }}
                                    </a>
                                    {% if s.type %}
                                        <div class="text-xs text-slate-500 mt-1">{{ s.type.label }}</div>
                                    {% endif %}
                                </td>

                                {# RESSOURCES #}
                                <td class="px-3 py-4 text-sm text-slate-500">
                                    <div class="flex flex-wrap gap-2">
                                        {% for lien in s.reservationResources %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-100">
                                                {{ lien.resource.name }}
                                                {% if lien.resource.category %}
                                                    ({{ lien.resource.category.name }})
                                                {% endif %}
                                            </span>
                                        {% else %}
                                            <span class="text-slate-400">-</span>
                                        {% endfor %}
                                    </div>
                                </td>

                                {# PROCHAINE SÉANCE #}
                                <td class="px-3 py-4 text-sm text-slate-500">
                                    {% set next = s.nextReservation %}
                                    {% if next %}
                                        <div class="flex items-start">
                                            <svg class="mr-1.5 h-4 w-4 text-slate-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                            <div>
                                                <div class="font-medium text-slate-700">{{ next.startDate|date('d/m/Y') }}</div>
                                                <div class="text-xs">à {{ next.startDate|date('H:i') }}</div>
                                            </div>
                                        </div>
                                    {% else %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600">
                                            Terminée / Passée
                                        </span>
                                    {% endif %}
                                </td>

                                {# STATUT #}
                                <td class="px-3 py-4 text-sm">
                                    {% if s.status %}
                                        {% set badgeClasses = 'bg-blue-100 text-blue-800' %}
                                        
                                        {% if s.status.id == 1 %}        {# En attente #}
                                            {% set badgeClasses = 'bg-amber-100 text-amber-800' %}
                                        {% elseif s.status.id == 2 %}    {# Approuvée #}
                                            {% set badgeClasses = 'bg-emerald-100 text-emerald-800' %}
                                        {% elseif s.status.id == 3 %}    {# Refusée #}
                                            {% set badgeClasses = 'bg-red-100 text-red-800' %}
                                        {% elseif s.status.id == 4 %}    {# Annulée #}
                                            {% set badgeClasses = 'bg-slate-100 text-slate-800' %}
                                        {% endif %}

                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ badgeClasses }}">
                                            {{ s.status.label }}
                                        </span>
                                    {% else %}
                                        <span class="text-slate-400">-</span>
                                    {% endif %}
                                </td>

                                {# ACTIONS #}
                                <td class="relative py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                    <a href="{{ path('reservation_show', {uuid: s.uuid}) }}" class="text-indigo-600 hover:text-indigo-900 inline-flex items-center gap-1">
                                        Détails
                                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
