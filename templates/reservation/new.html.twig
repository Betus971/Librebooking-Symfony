{% extends 'base.html.twig' %}
{% block title %}{{ 'reservation.new'|trans }} - Librebooking{% endblock %}
{% block body %}
    {# 1. STRUCTURE DU MODAL (DaisyUI) #}
    <dialog id="modal-dispo" class="modal modal-bottom sm:modal-middle">
        <div class="modal-box relative bg-base-100">
            <h3 class="font-bold text-lg mb-4 flex items-center gap-2 text-base-content">
                <svg class="h-6 w-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                {{ 'reservation_form.availability_label'|trans }} <span id="modal-resource-name" class="font-bold text-primary"></span>
            </h3>
            
            <div id="modal-slots-container" class="grid grid-cols-2 sm:grid-cols-3 gap-3 my-4">
                {# Injecté par JS #}
            </div>
            
            <div class="modal-action">
                <form method="dialog">
                    <button class="btn btn-ghost" id="btn-close-modal">{{ 'common.close'|trans }}</button>
                </form>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        
        <div class="mb-8">
            <h1 class="text-3xl font-extrabold text-base-content">{{ 'reservation.new'|trans }}</h1>
            <p class="mt-2 text-sm text-base-content/70">{{ 'reservation_form.subtitle'|trans }}</p>
        </div>

        <div class="card bg-base-100 shadow-xl border border-base-200">
            <div class="card-body sm:p-10">
                {{ form_start(form, {'attr': {'class': 'space-y-8', 'id': 'reservation-form'}}) }}

                {# ALERTE GLOBALE (client-side) #}
                <div id="form-client-alert" class="hidden alert alert-error shadow-sm" role="alert">
                    <svg class="h-6 w-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <div>
                        <h3 class="font-bold">{{ 'reservation_form.error_title'|trans }}</h3>
                        <div class="text-sm" id="form-client-alert-msg">{{ 'reservation_form.error_intro'|trans }}</div>
                    </div>
                </div>

                <div class="space-y-6">
                    {# 1. TITRE #}
                    <div class="form-control w-full">
                        {{ form_label(form.title, 'reservation_form.title_label'|trans, {'label_attr': {'class': 'label font-medium text-base-content'}}) }}
                        {{ form_widget(form.title, {'attr': {'class': 'input input-bordered w-full', 'placeholder': 'reservation_form.title_placeholder'|trans}}) }}
                        {% if form.title.vars.errors|length > 0 %}
                            <label class="label"><span class="label-text-alt text-error">{{ form_errors(form.title) }}</span></label>
                        {% endif %}
                    </div>

                    {# 2. RESSOURCE #}
                    <div class="form-control w-full">
                        {{ form_label(form.resource, 'reservation_form.resource_label'|trans, {'label_attr': {'class': 'label font-medium text-base-content'}}) }}
                        {{ form_widget(form.resource, {'attr': {'class': 'select select-bordered w-full', 'id': 'reservation_quick_resource'}}) }}
                        <div id="timeblocks-info" class="mt-2 text-sm text-base-content/60"></div>
                        {% if form.resource.vars.errors|length > 0 %}
                            <label class="label"><span class="label-text-alt text-error">{{ form_errors(form.resource) }}</span></label>
                        {% endif %}
                        
                        <div class="mt-3">
                            <button type="button" id="btn-open-dispo" class="btn btn-sm btn-outline btn-primary">
                                <svg class="mr-1.5 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                {{ 'reservation_form.see_availability'|trans }}
                            </button>
                        </div>
                    </div>

                    {# 3. DATES ET HEURES #}
                    <div class="grid grid-cols-1 gap-y-6 gap-x-6 sm:grid-cols-2" data-field="start">
                        <div class="form-control">
                            <label class="label font-medium text-base-content">{{ 'reservation_form.start_label'|trans }}</label>
                            <div class="grid grid-cols-2 gap-2">
                                {{ form_widget(form.startDate, { attr: {
                                    class: 'input input-bordered w-full',
                                    id: 'reservation_quick_start_date',
                                    min: 'now'|date('Y-m-d')
                                } }) }}
                                {{ form_widget(form.startTime, { attr: {
                                    class: 'input input-bordered w-full',
                                    id: 'reservation_quick_start_time'
                                } }) }}
                            </div>
                            <label class="label hidden js-client-error-start"><span class="label-text-alt text-error"></span></label>
                            {% if form.startDate.vars.errors|length > 0 %}<label class="label"><span class="label-text-alt text-error">{{ form_errors(form.startDate) }}</span></label>{% endif %}
                            {% if form.startTime.vars.errors|length > 0 %}<label class="label"><span class="label-text-alt text-error">{{ form_errors(form.startTime) }}</span></label>{% endif %}
                        </div>

                        <div class="form-control" data-field="end">
                            <label class="label font-medium text-base-content">{{ 'reservation_form.end_label'|trans }}</label>
                            <div class="grid grid-cols-2 gap-2">
                                {{ form_widget(form.endDate, { attr: {
                                    class: 'input input-bordered w-full',
                                    id: 'reservation_quick_end_date',
                                    min: 'now'|date('Y-m-d')
                                } }) }}
                                {{ form_widget(form.endTime, { attr: {
                                    class: 'input input-bordered w-full',
                                    id: 'reservation_quick_end_time'
                                } }) }}
                            </div>
                            <label class="label hidden js-client-error-end"><span class="label-text-alt text-error"></span></label>
                            {% if form.endDate.vars.errors|length > 0 %}<label class="label"><span class="label-text-alt text-error">{{ form_errors(form.endDate) }}</span></label>{% endif %}
                            {% if form.endTime.vars.errors|length > 0 %}<label class="label"><span class="label-text-alt text-error">{{ form_errors(form.endTime) }}</span></label>{% endif %}
                        </div>
                    </div>
                    
                    {# 4. PARTICIPANTS #}
                    <div class="divider">{{ 'reservation_form.participants'|trans }}</div>
                    <div class="form-control">
                        <label class="label font-medium text-base-content mb-1">{{ 'reservation_form.participants_list'|trans }}</label>
                        <p class="text-sm text-base-content/60 mb-4">{{ 'reservation_form.participants_hint'|trans }}</p>
                        
                        <div id="participants-list" data-prototype="{{ form_widget(form.participants.vars.prototype)|e('html_attr') }}" class="space-y-3">
                            {% for participant in form.participants %}
                                <div class="flex items-center gap-2 participant-item">
                                    <div class="flex-grow">
                                        {{ form_widget(participant, {'attr': {'class': 'input input-bordered w-full'}}) }}
                                    </div>
                                    <button type="button" class="btn btn-square btn-error btn-outline remove-participant" title="{{ 'common.delete'|trans }}">
                                        <svg class="h-5 w-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </button>
                                </div>
                            {% endfor %}
                        </div>
                        
                        <button type="button" id="add-participant-btn" class="btn btn-sm btn-ghost mt-4 w-fit border border-base-300">
                            <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                            {{ 'reservation_form.add_participant'|trans }}
                        </button>
                    </div>

                    {# 5. DESCRIPTION #}
                    <div class="divider">{{ 'reservation_form.reason'|trans }}</div>
                    <div class="form-control">
                        {{ form_label(form.description, 'reservation_form.description_label'|trans, {'label_attr': {'class': 'label font-medium text-base-content'}}) }}
                        {{ form_widget(form.description, {'attr': {'class': 'textarea textarea-bordered w-full', 'rows': 4}}) }}
                        {% if form.description.vars.errors|length > 0 %}
                            <label class="label"><span class="label-text-alt text-error">{{ form_errors(form.description) }}</span></label>
                        {% endif %}
                    </div>
                </div>

                {% if startError is defined and startError %}
                    <div class="alert alert-error shadow-sm mt-6" role="alert">
                        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span class="text-sm">{{ startError }}</span>
                    </div>
                {% endif %}

                {% if endError is defined and endError %}
                    <div class="alert alert-error shadow-sm mt-6" role="alert">
                        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span class="text-sm">{{ endError }}</span>
                    </div>
                {% endif %}

                {% if formError is defined and formError %}
                    <div class="alert alert-error shadow-sm mt-6" role="alert">
                        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span class="text-sm">{{ formError }}</span>
                    </div>
                {% endif %}

                {# Créneau indisponible → proposition d'inscription en liste d'attente #}
                {% if waitlist is defined and waitlist %}
                    <form method="post" action="{{ path('waitlist_join') }}" class="mt-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('waitlist_join') }}">
                        <input type="hidden" name="resource" value="{{ waitlist.resource }}">
                        <input type="hidden" name="start" value="{{ waitlist.start }}">
                        <input type="hidden" name="end" value="{{ waitlist.end }}">
                        <button type="submit" class="btn btn-outline btn-sm gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            {{ 'reservation_form.waitlist_join'|trans }}
                        </button>
                    </form>
                {% endif %}

                <div class="card-actions justify-end mt-8 border-t border-base-200 pt-6">
                    <a href="{{ path('app_resource_index') }}" class="btn btn-ghost">
                        {{ 'common.cancel'|trans }}
                    </a>
                    <button type="submit" class="btn btn-primary">
                        {{ 'reservation_form.confirm'|trans }}
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // --- DATES : aujourd'hui par défaut + fin alignée sur le début ---
            (function () {
                const sd = document.getElementById('reservation_quick_start_date');
                const ed = document.getElementById('reservation_quick_end_date');
                if (!sd || !ed) return;
                const today = new Date().toISOString().split('T')[0];
                if (!sd.value) sd.value = today;
                if (!ed.value) ed.value = sd.value;
                // Quand on change la date de début, on aligne la fin (sauf si déjà postérieure).
                sd.addEventListener('change', () => {
                    if (!ed.value || ed.value < sd.value) ed.value = sd.value;
                });
            })();

            // --- GESTION DE LA MODALE DAISYUI ---
            const btnOpenDispo = document.getElementById('btn-open-dispo');
            const modal = document.getElementById('modal-dispo');
            const selectResource = document.getElementById('reservation_quick_resource');
            const modalContainer = document.getElementById('modal-slots-container');

            const inputStartTime = document.getElementById('reservation_quick_start_time');
            const inputEndTime = document.getElementById('reservation_quick_end_time');
            const inputDate = document.getElementById('reservation_quick_start_date');

            if (btnOpenDispo) {
                btnOpenDispo.addEventListener('click', () => {
                    const resourceId = selectResource.value;
                    const dateVal = (inputDate && inputDate.value) ? inputDate.value : new Date().toISOString().split('T')[0];

                    if (!resourceId) {
                        alert("{{ 'reservation_form.select_resource_first'|trans|e('js') }}");
                        return;
                    }

                    document.getElementById('modal-resource-name').textContent = selectResource.options[selectResource.selectedIndex].text;
                    modal.showModal();

                    modalContainer.innerHTML = '<div class="col-span-full text-center py-8"><span class="loading loading-spinner text-primary loading-lg"></span><p class="mt-2 text-sm text-base-content/70">{{ 'reservation_form.loading_slots'|trans|e('js') }}</p></div>';

                    fetch('{{ path('app_availability_slots') }}?resource=' + resourceId + '&date=' + dateVal)
                        .then(r => r.json())
                        .then(list => {
                            if (list.length === 0) {
                                modalContainer.innerHTML = `<p class="col-span-full text-sm text-base-content/60 text-center py-4">{{ 'reservation_form.no_open_slots'|trans|e('js') }}</p>`;
                                return;
                            }

                            modalContainer.innerHTML = list.map(s => {
                                if (s.available) {
                                    return `
                                        <button type="button" class="js-select-slot btn btn-outline btn-primary btn-sm"
                                                data-start="${s.start}" data-end="${s.end}">
                                            ${s.label}
                                        </button>`;
                                }
                                // Créneau déjà réservé → grisé, non cliquable
                                return `
                                    <span class="btn btn-sm btn-disabled opacity-40 line-through cursor-not-allowed pointer-events-none"
                                          title="{{ 'reservation_form.already_booked'|trans|e('js') }}">
                                        ${s.label}
                                    </span>`;
                            }).join('');
                        })
                        .catch(err => {
                            modalContainer.innerHTML = `<div class="col-span-full p-4 alert alert-error shadow-sm text-sm">{{ 'reservation_form.slots_error'|trans|e('js') }}</div>`;
                        });
                });
            }

            if (modalContainer) {
                modalContainer.addEventListener('click', (e) => {
                    const btn = e.target.closest('.js-select-slot');
                    if (!btn) return;

                    if(inputStartTime) inputStartTime.value = btn.dataset.start;
                    if(inputEndTime) inputEndTime.value = btn.dataset.end;

                    modal.close();

                    inputStartTime.classList.add('input-success');
                    setTimeout(() => inputStartTime.classList.remove('input-success'), 2000);
                });
            }

            // --- GESTION DES PARTICIPANTS ---
            const addBtn = document.getElementById('add-participant-btn');
            const list = document.getElementById('participants-list');
            
            if (addBtn && list) {
                addBtn.addEventListener('click', () => {
                    let prototype = list.dataset.prototype;
                    const index = list.querySelectorAll('.participant-item').length;
                    prototype = prototype.replace(/__name__/g, index);
                    
                    // Inject DaisyUI classes
                    prototype = prototype.replace(/class="[^"]*"/g, 'class="input input-bordered w-full"');

                    const div = document.createElement('div');
                    div.classList.add('flex', 'items-center', 'gap-2', 'participant-item');
                    div.innerHTML = `
                        <div class="flex-grow">${prototype}</div>
                        <button type="button" class="btn btn-square btn-error btn-outline remove-participant" title="{{ 'common.delete'|trans|e('js') }}">
                            <svg class="h-5 w-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        </button>
                    `;
                    list.appendChild(div);
                });

                list.addEventListener('click', (e) => {
                    if (e.target.classList.contains('remove-participant') || e.target.closest('.remove-participant')) {
                        e.target.closest('.participant-item').remove();
                    }
                });
            }

            // --- VALIDATION CLIENT ---
            const inputStartDate   = document.getElementById('reservation_quick_start_date');
            const inputEndDate     = document.getElementById('reservation_quick_end_date');
            const inputStartTimeEl = document.getElementById('reservation_quick_start_time');
            const inputEndTimeEl   = document.getElementById('reservation_quick_end_time');
            const reservationForm  = document.getElementById('reservation-form');

            const groupStart = document.querySelector('[data-field="start"]');
            const groupEnd   = document.querySelector('[data-field="end"]');
            const errStart   = document.querySelector('.js-client-error-start');
            const errEnd     = document.querySelector('.js-client-error-end');

            const globalAlert    = document.getElementById('form-client-alert');
            const globalAlertMsg = document.getElementById('form-client-alert-msg');

            function showFieldError(group, errEl, msg) {
                if (!group || !errEl) return;
                group.querySelectorAll('input').forEach(i => i.classList.add('input-error'));
                errEl.querySelector('span').textContent = msg;
                errEl.classList.remove('hidden');
            }
            
            function clearFieldError(group, errEl) {
                if (!group || !errEl) return;
                group.querySelectorAll('input').forEach(i => i.classList.remove('input-error'));
                errEl.querySelector('span').textContent = '';
                errEl.classList.add('hidden');
            }
            
            function hideGlobalAlert() {
                if (!globalAlert) return;
                globalAlert.classList.add('hidden');
            }

            function buildDate(dateInput, timeInput) {
                if (!dateInput || !dateInput.value) return null;
                const t = (timeInput && timeInput.value) ? timeInput.value : '00:00';
                const tt = t.length === 5 ? t + ':00' : t;
                const d = new Date(dateInput.value + 'T' + tt);
                return isNaN(d.getTime()) ? null : d;
            }

            function validateDates() {
                clearFieldError(groupStart, errStart);
                clearFieldError(groupEnd, errEnd);

                const start = buildDate(inputStartDate, inputStartTimeEl);
                const end   = buildDate(inputEndDate, inputEndTimeEl);

                const errors = [];

                if (start) {
                    const today = new Date();
                    today.setHours(0, 0, 0, 0);
                    if (start < today) {
                        showFieldError(groupStart, errStart, '{{ 'reservation_form.err_past'|trans|e('js') }}');
                        errors.push('date de début');
                    }
                }

                if (start && end && end <= start) {
                    showFieldError(groupEnd, errEnd, '{{ 'reservation_form.err_end_before_start'|trans|e('js') }}');
                    errors.push('date de fin');
                }

                if (errors.length === 0) {
                    hideGlobalAlert();
                    return true;
                }
                hideGlobalAlert();
                return false;
            }

            [inputStartDate, inputEndDate, inputStartTimeEl, inputEndTimeEl].forEach(el => {
                if (!el) return;
                el.addEventListener('change', validateDates);
                el.addEventListener('blur', validateDates);
            });

            if (reservationForm) {
                reservationForm.addEventListener('submit', (e) => {
                    if (!validateDates()) {
                        e.preventDefault();
                        if (globalAlert) {
                            globalAlert.classList.remove('hidden');
                            globalAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }
                    }
                });
            }
        });
    </script>
{% endblock %}
