<div class="fr-grid-row fr-grid-row--gutters">
    <div class="fr-col-12 fr-col-md-12">

<div id="card-{{ resource.id }}" class="fr-card fr-card--lg fr-card--horizontal">
    <div class="fr-card__body">
        <div class="fr-card__content">
            <h3 class="fr-card__title">
                <a href="{{ path('app_resource_show', {'id': resource.id}) }}">
                    {{ resource.name }}
                </a>
            </h3>

            {% if resource.description %}
                <p class="fr-card__desc">{{ resource.description }}</p>
            {% endif %}

            <div class="fr-card__start">
                <ul class="fr-tags-group">
                    {% if resource.maxParticipants is not null %}
                        <li><p class="fr-tag">{{ resource.maxParticipants }} places</p></li>
                    {% endif %}
                    {% if resource.unitCost is not null %}
                        <li><p class="fr-tag">{{ resource.unitCost }} €</p></li>
                    {% endif %}
                    {% if resource.isActive %}
                        <li><p class="fr-tag">Disponible</p></li>
                    {% else %}
                        <li><p class="fr-tag">Indisponible</p></li>
                    {% endif %}
                </ul>

                {% if resource.contactInfo %}
                    <p class="fr-card__detail fr-icon-mail-line">
                        {{ resource.contactInfo }}
                    </p>
                {% endif %}
            </div>

            <div class="fr-card__end">
                {% if resource.location %}
                    <p class="fr-card__detail fr-icon-map-pin-2-line">
                        {{ resource.location }}
                    </p>
                {% endif %}
            </div>
        </div>

        <div class="fr-card__footer">
            <ul class="fr-btns-group fr-btns-group--inline-reverse fr-btns-group--inline-lg">
{#                <li>#}
{#                    <a href="{{ path('app_resource_show', {'id': resource.id}) }}" class="fr-btn">#}
{#                        Voir la fiche#}
{#                    </a>#}
{#                </li>#}
                <li>
                    <a href="#" class="fr-btn fr-btn--secondary">
                        Réserver
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <div class="fr-card__header">
        <div class="fr-card__img">
            {# Image fixe en dur dans public/image/ (pas en DB) #}
            <img class="fr-responsive-img"
                 src="{{ asset('image/amphi.jpg') }}"
                 alt="Photo de {{ resource.name }}" />
        </div>
    </div>
</div>
    </div>
</div>
