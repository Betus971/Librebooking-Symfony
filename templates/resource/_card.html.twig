<div id="card-{{ resource.id }}" class="card md:card-side bg-base-100 border border-base-300 shadow-sm">
    <figure class="md:w-64 shrink-0">
        <img class="w-full h-48 md:h-full object-cover" src="{{ asset('image/amphi.jpg') }}" alt="Photo de {{ resource.name }}">
    </figure>
    <div class="card-body">
        <h3 class="card-title">
            <a href="{{ path('app_resource_show', {'id': resource.id}) }}" class="hover:text-primary">{{ resource.name }}</a>
        </h3>

        {% if resource.description %}
            <p class="text-sm text-base-content/70">{{ resource.description }}</p>
        {% endif %}

        <div class="flex flex-wrap gap-2 mt-1">
            {% if resource.maxParticipants is not null %}<span class="badge badge-outline">{{ resource.maxParticipants }} {{ 'common.places'|trans }}</span>{% endif %}
            {% if resource.unitCost is not null %}<span class="badge badge-outline">{{ resource.unitCost }} €</span>{% endif %}
            {% if resource.isActive %}
                <span class="badge badge-success">{{ 'common.available'|trans }}</span>
            {% else %}
                <span class="badge badge-ghost">{{ 'common.unavailable'|trans }}</span>
            {% endif %}
        </div>

        {% if resource.contactInfo %}<p class="text-xs text-base-content/60 mt-2">✉ {{ resource.contactInfo }}</p>{% endif %}
        {% if resource.location %}<p class="text-xs text-base-content/60">📍 {{ resource.location }}</p>{% endif %}

        <div class="card-actions justify-end mt-3">
            <a href="{{ path('reservation_new', {'resource': resource.id}) }}" class="btn btn-primary btn-sm">{{ 'common.book'|trans }}</a>
        </div>
    </div>
</div>
