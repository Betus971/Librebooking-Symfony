<form method="post" action="{{ path('app_resource_delete', {'id': resource.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette ressource ?');" class="fr-my-2w">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ resource.id) }}">
    <button class="fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-delete-line">
        Supprimer la ressource
    </button>
</form>
