{% block duration_unit_widget %}
    {# Valeur #}
    <div class="form-control w-full mb-4">
        {{ form_label(form.value, 'Valeur', {'label_attr': {'class':'label font-medium text-base-content'}}) }}
        {{ form_widget(form.value, {'attr': {'class':'input input-bordered w-full max-w-xs', 'inputmode':'numeric'}}) }}
        {% if form.value.vars.errors|length > 0 %}
            <label class="label"><span class="label-text-alt text-error">{{ form_errors(form.value) }}</span></label>
        {% endif %}
    </div>

    {# Unités (radios) #}
    <div class="form-control mb-2">
        <label class="label font-medium text-base-content">Unité</label>

        {% if form.unit is defined %}
            <div class="flex flex-wrap gap-4">
                {{ form_widget(form.unit, {
                    'expanded': true,
                    'attr': {'class': 'flex gap-4'}
                }) }}
            </div>
            {% if form.unit.vars.errors|length > 0 %}
                <label class="label"><span class="label-text-alt text-error">{{ form_errors(form.unit) }}</span></label>
            {% endif %}
        {% else %}
            {# Fallback manuel si le sous-champ unit n'existe pas #}
            <div class="flex flex-wrap gap-4">
                {% set units = form.vars.allowed_units ?? ['m','h','d'] %}
                {% set current = attribute(form.vars.value ?? {}, 'unit') ?? 'm' %}
                {% for u in units %}
                    <label class="label cursor-pointer gap-2">
                        <input type="radio"
                               id="{{ form.vars.id }}_unit_{{ u }}"
                               name="{{ form.vars.full_name }}[unit]"
                               value="{{ u }}"
                               class="radio radio-primary"
                               {% if current == u %}checked{% endif %}>
                        <span class="label-text">
                            {{ {'m':'minutes','h':'heures','d':'jours'}[u] ?? u }}
                        </span>
                    </label>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
