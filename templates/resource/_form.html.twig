{% form_theme form 'form/duration_unit_theme.html.twig' %}
{{ form_start(form, { attr: {
    'novalidate': 'novalidate',
    'class': 'space-y-6',
    'enctype': 'multipart/form-data'
} }) }}

{# --- SYSTEME D'ONGLETS DAISYUI --- #}
<div role="tablist" class="tabs tabs-lifted tabs-lg mb-6">
    <input type="radio" name="resource_tabs" role="tab" class="tab font-bold" aria-label="Identité & Infos" checked="checked" />
    <div role="tabpanel" class="tab-content bg-base-100 border-base-300 rounded-box p-6">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
            <div class="md:col-span-12">
                {{ form_row(form.name, { attr: { placeholder: 'Ex: Salle de réunion A...', class: 'input input-bordered w-full' } }) }}
            </div>

            <div class="md:col-span-4">
                {{ form_row(form.category, { attr: { class: 'select select-bordered w-full' } }) }}
            </div>

            <div class="md:col-span-4">
                {{ form_row(form.resourceGroup, { attr: { class: 'select select-bordered w-full' } }) }}
            </div>
            
            <div class="md:col-span-4">
                {{ form_row(form.location, { attr: { placeholder: 'Ex: Batiment B, 1er étage', class: 'input input-bordered w-full' } }) }}
            </div>

            <div class="md:col-span-12">
                {{ form_row(form.description, { attr: { rows: 4, placeholder: 'Description visible par les utilisateurs...', class: 'textarea textarea-bordered w-full' } }) }}
            </div>

            <div class="md:col-span-12">
                {{ form_row(form.contactInfo, { label: 'Contact responsable (Email/Tél)', attr: { placeholder: 'Ex: regie@mairie.fr', class: 'input input-bordered w-full' } }) }}
            </div>
            
            <div class="md:col-span-12">
                {{ form_row(form.photo, { attr: { class: 'file-input file-input-bordered w-full' } }) }}
            </div>
        </div>
    </div>

    <input type="radio" name="resource_tabs" role="tab" class="tab font-bold" aria-label="Fonctionnement" />
    <div role="tabpanel" class="tab-content bg-base-100 border-base-300 rounded-box p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            {# Bloc principal #}
            <div>
                {{ form_row(form.schedule, { label: 'Planning de référence', attr: { class: 'select select-bordered w-full' } }) }}
                <div class="label"><span class="label-text-alt">Définit les heures d'ouverture globales.</span></div>
            </div>
            <div>
                {{ form_row(form.maxParticipants, { label: 'Capacité maximale (personnes)', attr: { class: 'input input-bordered w-full' } }) }}
            </div>

            <div class="col-span-full divider">Paramètres d'activation</div>

            {# Toggle Switches DaisyUI #}
            <div class="form-control">
                <label class="label cursor-pointer justify-start gap-4">
                    <input type="checkbox" class="toggle toggle-primary"
                           id="{{ form.isActive.vars.id }}"
                           name="{{ form.isActive.vars.full_name }}"
                           {% if form.isActive.vars.checked %}checked{% endif %}
                           value="1">
                    <span class="label-text font-medium">{{ form.isActive.vars.label|default('Ressource active') }}</span>
                </label>
                <div class="label justify-start ml-16"><span class="label-text-alt">Si désactivée, elle n'apparaît plus pour les utilisateurs.</span></div>
                {% do form.isActive.setRendered() %}
            </div>

            <div class="form-control">
                <label class="label cursor-pointer justify-start gap-4">
                    <input type="checkbox" class="toggle toggle-info"
                           id="{{ form.requiresApproval.vars.id }}"
                           name="{{ form.requiresApproval.vars.full_name }}"
                           {% if form.requiresApproval.vars.checked %}checked{% endif %}
                           value="1">
                    <span class="label-text font-medium">{{ form.requiresApproval.vars.label|default('Approbation requise') }}</span>
                </label>
                <div class="label justify-start ml-16"><span class="label-text-alt">Un administrateur devra valider chaque demande.</span></div>
                {% do form.requiresApproval.setRendered() %}
            </div>

            <div class="form-control mt-4">
                <label class="label cursor-pointer justify-start gap-4">
                    <input type="checkbox" class="toggle toggle-secondary"
                           id="{{ form.allowMultiday.vars.id }}"
                           name="{{ form.allowMultiday.vars.full_name }}"
                           {% if form.allowMultiday.vars.checked %}checked{% endif %}
                           value="1">
                    <span class="label-text font-medium">{{ form.allowMultiday.vars.label|default('Autoriser sur plusieurs jours') }}</span>
                </label>
                {% do form.allowMultiday.setRendered() %}
            </div>

        </div>
    </div>

    <input type="radio" name="resource_tabs" role="tab" class="tab font-bold" aria-label="Temps & Délais" />
    <div role="tabpanel" class="tab-content bg-base-100 border-base-300 rounded-box p-6">

        <div class="card bg-base-200 shadow-sm mb-6">
            <div class="card-body p-6">
                <h3 class="card-title text-lg">Durée des créneaux</h3>
                <p class="text-sm text-base-content/70">Laissez vide si vous ne souhaitez pas imposer de limite.</p>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
                    <div>
                        {{ form_row(form.minDuration, { label: 'Durée minimale', attr: { class: 'input input-bordered w-full' } }) }}
                    </div>
                    <div>
                        {{ form_row(form.maxDuration, { label: 'Durée maximale', attr: { class: 'input input-bordered w-full' } }) }}
                    </div>
                    <div>
                        {{ form_row(form.minIncrement, { label: 'Pas (Incrément)', attr: { class: 'input input-bordered w-full' } }) }}
                        <div class="label"><span class="label-text-alt">Ex: Pas de 15 min = 9h00, 9h15...</span></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card bg-orange-50 dark:bg-orange-950/20 shadow-sm mb-6 border border-orange-100 dark:border-orange-900">
            <div class="card-body p-6">
                <h3 class="card-title text-lg text-orange-800 dark:text-orange-200">Délais d'anticipation</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                    <div>
                        {{ form_row(form.minNoticeTimeAdd, { label: 'Délai min. avant Création', attr: { class: 'input input-bordered w-full' } }) }}
                    </div>
                    <div>
                        {{ form_row(form.maxNoticeTime, { label: 'Anticipation maximale', attr: { class: 'input input-bordered w-full' } }) }}
                    </div>
                    <div>
                        {{ form_row(form.minNoticeTimeUpdate, { label: 'Délai min. avant Modification', attr: { class: 'input input-bordered w-full' } }) }}
                    </div>
                    <div>
                        {{ form_row(form.minNoticeTimeDelete, { label: 'Délai min. avant Annulation', attr: { class: 'input input-bordered w-full' } }) }}
                    </div>
                </div>
            </div>
        </div>

        <div class="card bg-info/10 shadow-sm border border-info/20 mt-6">
            <div class="card-body p-6">
                <h3 class="card-title text-lg text-info flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Options avancées
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                    <div>
                        {{ form_row(form.bufferTime, { label: 'Temps tampon (Buffer)', attr: { class: 'input input-bordered w-full' } }) }}
                        <div class="label"><span class="label-text-alt">Pause forcée entre deux réservations.</span></div>
                    </div>
                    <div>
                        {{ form_row(form.autoReleaseMinutes, { label: 'Libération auto', attr: { class: 'input input-bordered w-full' } }) }}
                        <div class="label"><span class="label-text-alt">Si non confirmé après X minutes (0 = désactivé).</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# --- BOUTONS D'ACTION --- #}
<div class="flex justify-end gap-4 mt-8 mb-4">
    <a href="{{ cancel_url|default(path('app_resource_index')) }}" class="btn btn-ghost">
        Annuler
    </a>
    <button type="submit" class="btn btn-primary">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg>
        {{ submit_label|default('Enregistrer la ressource') }}
    </button>
</div>

{{ form_end(form) }}
