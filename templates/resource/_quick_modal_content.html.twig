{# {% extends 'base.html.twig' %} #}

{% block body %}
    <div class="p-4 sm:p-6">

<h3 id="modal-create-title" class="font-bold text-lg mb-6 flex items-center gap-2">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
    Créer une ressource
</h3>

{{ form_start(form, { attr: { class: 'space-y-4' } }) }}
<div class="grid grid-cols-1 gap-4">
    <div>{{ form_row(form.name) }}</div>
    <div>{{ form_row(form.schedule) }}</div>
    <div>{{ form_row(form.location) }}</div>
    <div>{{ form_row(form.maxParticipants) }}</div>
    <div>{{ form_row(form.unitCost) }}</div>

    <div>
        <div class="form-control w-full">
            <label class="label" for="{{ form.photo.vars.id }}">
                <span class="label-text font-medium text-base-content">Photo (JPEG/PNG)</span>
                <span class="label-text-alt text-base-content/60">Taille max 4 Mo</span>
            </label>
            {{ form_widget(form.photo, { attr: { class: 'file-input file-input-bordered w-full' } }) }}
            {% if form.photo.vars.errors|length > 0 %}
                <label class="label"><span class="label-text-alt text-error">{{ form_errors(form.photo) }}</span></label>
            {% endif %}
        </div>
    </div>
</div>

<div class="mt-8 flex justify-end">
    <button class="btn btn-primary" type="submit">Créer</button>
</div>
{{ form_end(form) }}
</div>
{% endblock %}
