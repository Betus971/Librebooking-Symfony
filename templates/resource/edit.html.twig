{% extends 'base.html.twig' %}

{% block title %}Edit Resource{% endblock %}

{% block body %}

    <div class="fr-container fr-my-4w">
        <h1 class="fr-h2 fr-mb-2w">Éditer la ressource</h1>
        <p class="fr-hint-text fr-mb-3w">Modifie les informations de cette ressource.</p>

        {{ include('resource/_form.html.twig', { form: form }) }}

        <div class="fr-mt-4w">
            <a href="{{ path('app_resource_index') }}"
               class="fr-link fr-icon-arrow-left-line fr-link--icon-left">Retour à la liste</a>
        </div>
    </div>
{% endblock %}
