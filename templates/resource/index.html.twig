{% extends 'base.html.twig' %}

{% block title %}Catalogue des ressources - Librebooking{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    {# --- EN-TÊTE --- #}
    <div class="md:flex md:items-center md:justify-between mb-8">
        <div class="flex-1 min-w-0">
            <h2 class="text-2xl font-bold leading-7 text-slate-900 sm:text-3xl sm:truncate">
                Catalogue des ressources
            </h2>
            <p class="mt-1 flex flex-col sm:flex-row sm:flex-wrap sm:mt-0 sm:space-x-6">
                <span class="mt-2 flex items-center text-sm text-slate-500">
                    <svg class="flex-shrink-0 mr-1.5 h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                    {{ resources|length }} ressource(s) trouvée(s)
                </span>
            </p>
        </div>
    </div>

    {# --- BARRE DE FILTRES --- #}
    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 mb-8">
        <form method="get" class="flex flex-col md:flex-row gap-4 items-end">
            <div class="flex-1 w-full">
                <label for="q" class="block text-sm font-medium text-slate-700">Rechercher</label>
                <div class="mt-1 relative rounded-md shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                    <input type="text" name="q" id="q" value="{{ filters.q ?? '' }}" class="focus:ring-indigo-500 focus:border-indigo-500 block w-full pl-10 sm:text-sm border-slate-300 rounded-md py-2 border" placeholder="Nom, lieu...">
                </div>
            </div>

            <div class="flex-1 w-full">
                <label for="schedule" class="block text-sm font-medium text-slate-700">Planning</label>
                <select id="schedule" name="schedule" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-slate-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md border">
                    <option value="">Tous les plannings</option>
                    {% for s in schedules %}
                        <option value="{{ s.id }}" {{ (filters.schedule ?? null) == s.id ? 'selected' }}>{{ s.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="flex-1 w-full">
                <label for="status" class="block text-sm font-medium text-slate-700">Statut</label>
                <select id="status" name="status" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-slate-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md border">
                    {% set st = filters.status ?? 'active' %}
                    <option value="all" {{ st == 'all' ? 'selected' }}>Tous</option>
                    <option value="active" {{ st == 'active' ? 'selected' }}>Actives uniquement</option>
                    <option value="inactive" {{ st == 'inactive' ? 'selected' }}>Inactives / Archivées</option>
                </select>
            </div>

            <div class="w-full md:w-auto flex gap-2">
                <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 w-full md:w-auto justify-center">
                    Filtrer
                </button>
                {% if filters.q or filters.schedule or (filters.status and filters.status != 'all') %}
                    <a href="{{ path('app_resource_index') }}" class="inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 w-full md:w-auto justify-center">
                        Effacer
                    </a>
                {% endif %}
            </div>
            
            <input type="hidden" name="view" value="{{ view }}">
        </form>
    </div>

    {# --- VUES TOGGLE --- #}
    <div class="flex justify-end mb-4">
        <span class="relative z-0 inline-flex shadow-sm rounded-md">
            <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'view': 'table'})) }}" class="relative inline-flex items-center px-4 py-2 rounded-l-md border border-slate-300 bg-white text-sm font-medium {{ view == 'table' ? 'text-indigo-600 z-10 border-indigo-500 bg-indigo-50' : 'text-slate-700 hover:bg-slate-50' }}">
                <svg class="mr-2 h-5 w-5 {{ view == 'table' ? 'text-indigo-500' : 'text-slate-400' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                Tableau
            </a>
            <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'view': 'cards'})) }}" class="-ml-px relative inline-flex items-center px-4 py-2 rounded-r-md border border-slate-300 bg-white text-sm font-medium {{ view == 'cards' ? 'text-indigo-600 z-10 border-indigo-500 bg-indigo-50' : 'text-slate-700 hover:bg-slate-50' }}">
                <svg class="mr-2 h-5 w-5 {{ view == 'cards' ? 'text-indigo-500' : 'text-slate-400' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                Cartes
            </a>
        </span>
    </div>

    {# === CONTENU === #}

    {% if view == 'cards' %}
        {# --- VUE CARTES --- #}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {% for resource in resources %}
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-lg transition-shadow duration-300 flex flex-col">
                    <div class="relative h-48 bg-slate-100 group">
                        {% if resource.imageName %}
                            <img src="{{ asset('uploads/resources/' ~ resource.imageName) }}" alt="{{ resource.name }}" class="w-full h-full object-cover">
                        {% else %}
                            <div class="w-full h-full flex items-center justify-center text-slate-300">
                                <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            </div>
                        {% endif %}
                        <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-10 transition-opacity flex items-center justify-center opacity-0 group-hover:opacity-100">
                            <a href="{{ path('app_resource_show', {id: resource.id}) }}" class="bg-white text-indigo-600 px-4 py-2 rounded-lg font-medium shadow-md hover:bg-indigo-50 transition-colors">
                                Voir détails
                            </a>
                        </div>
                    </div>
                    <div class="p-5 flex-1 flex flex-col">
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="text-lg font-bold text-slate-900 line-clamp-1">
                                <a href="{{ path('app_resource_show', {id: resource.id}) }}" class="hover:text-indigo-600 transition-colors">{{ resource.name }}</a>
                            </h3>
                            {% if resource.isActive %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-100 text-emerald-800">Active</span>
                            {% else %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-800">Inactive</span>
                            {% endif %}
                        </div>
                        
                        <p class="text-sm text-slate-500 line-clamp-2 mb-4 flex-1">
                            {{ resource.description }}
                        </p>
                        
                        <div class="mt-auto space-y-2 text-sm text-slate-600">
                            {% if resource.location %}
                                <div class="flex items-center">
                                    <svg class="mr-1.5 h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                    {{ resource.location }}
                                </div>
                            {% endif %}
                            {% if resource.maxParticipants %}
                                <div class="flex items-center">
                                    <svg class="mr-1.5 h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                                    Jusqu'à {{ resource.maxParticipants }} pers.
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-span-full py-12 text-center bg-slate-50 rounded-2xl border-2 border-dashed border-slate-300">
                    <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-slate-900">Aucune ressource trouvée</h3>
                    <p class="mt-1 text-sm text-slate-500">Essayez de modifier vos filtres de recherche.</p>
                </div>
            {% endfor %}
        </div>
    {% else %}
        {# --- VUE TABLEAU --- #}
        <div class="bg-white shadow-sm ring-1 ring-black ring-opacity-5 rounded-2xl overflow-hidden border border-slate-200">
            <table class="min-w-full divide-y divide-slate-300">
                <thead class="bg-slate-50">
                    <tr>
                        <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-slate-900 sm:pl-6 w-16">Image</th>
                        <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-slate-900 w-1/4">Nom</th>
                        <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900 hidden md:table-cell">Catégorie</th>
                        <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900 hidden sm:table-cell">Lieu</th>
                        <th scope="col" class="px-3 py-3.5 text-center text-sm font-semibold text-slate-900 hidden lg:table-cell">Capacité</th>
                        <th scope="col" class="px-3 py-3.5 text-center text-sm font-semibold text-slate-900">Statut</th>
                        <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white">
                    {% for resource in resources %}
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="py-4 pl-4 pr-3 text-sm sm:pl-6">
                                {% if resource.imageName %}
                                    <img src="{{ asset('uploads/resources/' ~ resource.imageName) }}" alt="{{ resource.name }}" class="h-10 w-10 rounded-lg object-cover">
                                {% else %}
                                    <div class="h-10 w-10 rounded-lg bg-slate-100 flex items-center justify-center text-slate-400">
                                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    </div>
                                {% endif %}
                            </td>
                            <td class="py-4 pl-4 pr-3 text-sm">
                                <div class="font-medium text-slate-900">
                                    <a href="{{ path('app_resource_show', {id: resource.id}) }}" class="hover:text-indigo-600 transition-colors">{{ resource.name }}</a>
                                </div>
                                {% if resource.requiresApproval %}
                                    <div class="mt-1">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">Approbation requise</span>
                                    </div>
                                {% endif %}
                            </td>
                            <td class="px-3 py-4 text-sm text-slate-500 hidden md:table-cell">
                                {% if resource.category %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800">
                                        {{ resource.category.name }}
                                    </span>
                                {% else %}
                                    <span class="text-slate-400">-</span>
                                {% endif %}
                            </td>
                            <td class="px-3 py-4 text-sm text-slate-500 hidden sm:table-cell">
                                {{ resource.location ?? '-' }}
                            </td>
                            <td class="px-3 py-4 text-sm text-slate-500 text-center hidden lg:table-cell">
                                {% if resource.maxParticipants %}
                                    {{ resource.maxParticipants }} <span class="text-xs">pers.</span>
                                {% else %}
                                    <span class="text-slate-400">-</span>
                                {% endif %}
                            </td>
                            <td class="px-3 py-4 text-sm text-center">
                                {% if resource.isActive %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">Active</span>
                                {% else %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800">Inactive</span>
                                {% endif %}
                            </td>
                            <td class="py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                <a href="{{ path('app_resource_show', {id: resource.id}) }}" class="text-indigo-600 hover:text-indigo-900">Voir<span class="sr-only">, {{ resource.name }}</span></a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="px-3 py-12 text-center text-sm text-slate-500 bg-slate-50">
                                Aucune ressource ne correspond à votre recherche.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

</div>
{% endblock %}
