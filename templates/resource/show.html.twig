{% extends 'base.html.twig' %}

{% block title %}{{ resource.name }} - Librebooking{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    {# --- FIL D'ARIANE --- #}
    <nav class="flex mb-8" aria-label="Breadcrumb">
        <ol role="list" class="flex items-center space-x-4">
            <li>
                <div>
                    <a href="{{ path('app_home') }}" class="text-slate-400 hover:text-slate-500">
                        <svg class="flex-shrink-0 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                        <span class="sr-only">Accueil</span>
                    </a>
                </div>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="flex-shrink-0 h-5 w-5 text-slate-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
                    <a href="{{ path('app_resource_index') }}" class="ml-4 text-sm font-medium text-slate-500 hover:text-slate-700">Catalogue</a>
                </div>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="flex-shrink-0 h-5 w-5 text-slate-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
                    <span class="ml-4 text-sm font-medium text-slate-700" aria-current="page">{{ resource.name }}</span>
                </div>
            </li>
        </ol>
    </nav>

    <div class="bg-white shadow-xl shadow-slate-200/40 rounded-3xl overflow-hidden border border-slate-100">
        <div class="lg:flex">
            
            {# --- IMAGE COL --- #}
            <div class="lg:w-2/5 xl:w-1/2 relative bg-slate-100">
                {% set img = resource.imageName ? asset('uploads/resources/' ~ resource.imageName) : null %}
                {% if img %}
                    <img src="{{ img }}" alt="{{ resource.name }}" class="absolute inset-0 w-full h-full object-cover">
                {% else %}
                    <div class="absolute inset-0 flex items-center justify-center text-slate-300 bg-slate-50">
                        <svg class="w-32 h-32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    </div>
                {% endif %}
                <div class="lg:hidden block pt-[70%]"></div>
            </div>

            {# --- CONTENT COL --- #}
            <div class="lg:w-3/5 xl:w-1/2 p-8 sm:p-12 flex flex-col">
                <div class="flex-1">
                    <div class="flex flex-wrap items-center gap-3 mb-4">
                        {% if resource.category %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-indigo-100 text-indigo-800">
                                {{ resource.category.name }}
                            </span>
                        {% endif %}
                        
                        {% if resource.isActive %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-emerald-100 text-emerald-800">
                                Active
                            </span>
                        {% else %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-slate-100 text-slate-800">
                                Inactive
                            </span>
                        {% endif %}
                        
                        {% if resource.requiresApproval %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 border border-blue-200">
                                Approbation requise
                            </span>
                        {% endif %}
                    </div>

                    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-6 tracking-tight">{{ resource.name }}</h1>

                    {% if resource.description %}
                        <div class="prose prose-slate prose-lg mb-8 text-slate-600">
                            <p>{{ resource.description }}</p>
                        </div>
                    {% endif %}

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8 border-t border-slate-100 pt-8">
                        <div>
                            <dt class="text-sm font-medium text-slate-500 mb-1">Localisation</dt>
                            <dd class="text-base font-semibold text-slate-900 flex items-center">
                                <svg class="mr-2 h-5 w-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                {{ resource.location|default('Non renseignée') }}
                            </dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-slate-500 mb-1">Capacité maximale</dt>
                            <dd class="text-base font-semibold text-slate-900 flex items-center">
                                <svg class="mr-2 h-5 w-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                                {{ resource.maxParticipants ? resource.maxParticipants ~ ' personnes' : 'Illimitée' }}
                            </dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-slate-500 mb-1">Contact responsable</dt>
                            <dd class="text-base font-semibold text-slate-900 flex items-center">
                                <svg class="mr-2 h-5 w-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                                {{ resource.contactInfo|default('Non défini') }}
                            </dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-slate-500 mb-1">Durée autorisée</dt>
                            <dd class="text-base font-semibold text-slate-900 flex items-center">
                                <svg class="mr-2 h-5 w-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                {{ resource.minDuration }} à {{ resource.maxDuration }} min
                            </dd>
                        </div>
                    </div>
                </div>

                <div class="mt-8 pt-8 border-t border-slate-100">
                    <a href="{{ path('app_calendar', {'resource': resource.id}) }}" class="w-full flex items-center justify-center px-8 py-4 border border-transparent text-lg font-medium rounded-xl text-white bg-indigo-600 hover:bg-indigo-700 shadow-lg shadow-indigo-600/30 hover:shadow-indigo-600/40 transition-all transform hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        <svg class="mr-2 h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        Réserver cette ressource
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
