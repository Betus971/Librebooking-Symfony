{% extends 'base.html.twig' %}

{% block title %}ResourceCategory index{% endblock %}

{% block body %}
    <div class="fr-container fr-my-4w">

        {# --- EN-TÊTE --- #}
        <div class="fr-grid-row fr-grid-row--middle fr-mb-3w">
            <div class="fr-col">
                <h1 class="fr-h2 fr-mb-0">Catégories de ressources</h1>
                <p class="fr-text--sm fr-text--mention-grey fr-mb-0">{{ resource_categories|length }} catégories enregistrées</p>
            </div>
            <div class="fr-col-auto">
                <a href="{{ path('app_resource_category_new') }}" class="fr-btn fr-icon-add-line fr-btn--icon-left">
                    Nouvelle catégorie
                </a>
            </div>
        </div>

        {# --- TABLEAU --- #}
        <div class="fr-table fr-table--bordered fr-table--layout-fixed">
            <div class="fr-table__wrapper">
                <div class="fr-table__container">
                    <div class="fr-table__content">
                        <table>
                            <caption class="fr-sr-only">Liste des catégories de ressources</caption>
                            <thead>
                            <tr>
                                <th scope="col" style="width: 30%;">Nom</th>
                                <th scope="col">Description</th>
                                <th scope="col" class="fr-text--right">Ressources</th>
                                <th scope="col" class="fr-text--right">Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for c in resource_categories %}
                                <tr>
                                    <td>
                                        {# Amélioration : Le nom est cliquable directement #}
                                        <a href="{{ path('app_resource_category_show', {id: c.id}) }}" class="fr-text--bold fr-link">
                                            {{ c.name }}
                                        </a>
                                    </td>
                                    <td>
                                        {% if c.description %}
                                            <span class="fr-text--sm">{{ c.description|u.truncate(100, '…') }}</span>
                                        {% else %}
                                            <span class="fr-text--mention-grey fr-text--sm">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="fr-text--right">
                                        {# Badge bleu clair si > 0, gris sinon #}
                                        {% set count = c.resources|length %}
                                        {% if count > 0 %}
                                            <p class="fr-badge fr-badge--info fr-badge--sm fr-badge--no-icon">{{ count }}</p>
                                        {% else %}
                                            <p class="fr-badge fr-badge--sm fr-badge--no-icon">0</p>
                                        {% endif %}
                                    </td>
                                    <td class="fr-text--right">
                                        <ul class="fr-btns-group fr-btns-group--inline fr-btns-group--sm fr-btns-group--right">
                                            <li>
                                                <a class="fr-btn fr-btn--tertiary-no-outline fr-icon-edit-line"
                                                   href="{{ path('app_resource_category_edit', {id: c.id}) }}"
                                                   title="Modifier">
                                                    Modifier
                                                </a>
                                            </li>
                                        </ul>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="fr-text--center fr-text--sm fr-p-3w">
                                        Aucune catégorie trouvée. <br>
                                        <a href="{{ path('app_resource_category_new') }}">Créer la première catégorie</a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
{% endblock %}
