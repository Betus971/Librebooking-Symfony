{% extends 'base.html.twig' %}

{% block title %}Réservation – {{ resource_category.name }}{% endblock %}

{% block body %}
<div class="fr-container fr-mt-4w fr-mb-8w">

    {# ── Fil d'Ariane ─────────────────────────────────────────────────────── #}
    <nav role="navigation" class="fr-breadcrumb fr-mb-3w" aria-label="vous êtes ici :">
        <ol class="fr-breadcrumb__list">
            <li><a class="fr-breadcrumb__link" href="{{ path('app_home') }}">Accueil</a></li>
            <li><a class="fr-breadcrumb__link" aria-current="page">{{ resource_category.name }}</a></li>
        </ol>
    </nav>

    {# ── En-tête ───────────────────────────────────────────────────────────── #}
    <ul class="fr-tags-group fr-mb-2w">
        <li><p class="fr-tag">{{ resource_category.name }}</p></li>
    </ul>
    <h1 class="fr-h2 fr-mb-1w">Réservation de {{ resource_category.name }}</h1>
    <p class="fr-text--lead fr-mb-4w">
        Choisissez une date, un créneau et, si besoin, des filtres&nbsp;: les salles non
        disponibles seront automatiquement retirées.
    </p>

    {# ── Sélecteur de date ────────────────────────────────────────────────── #}
    <div class="fr-card fr-card--no-border fr-mb-4w"
         style="border:1px solid #ddd; border-radius:4px; padding:1.25rem 1.5rem 1rem;">
        <form method="get">
            <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--middle">
                <div class="fr-col-auto">
                    <span class="fr-icon-calendar-line" aria-hidden="true"></span>
                    <strong class="fr-ml-1w">Sélectionnez une date</strong>
                </div>
                <div class="fr-col-12 fr-col-md-4">
                    <div class="fr-input-group fr-mb-0">
                        <label class="fr-label" for="date-picker">Date de réservation</label>
                        <input class="fr-input"
                               type="date"
                               id="date-picker"
                               name="date"
                               value="{{ selectedDate }}"
                               onchange="this.form.submit()">
                    </div>
                </div>
            </div>
        </form>
    </div>

    {# ── Bandeau résultats + bouton filtres ───────────────────────────────── #}
    <div class="fr-grid-row fr-grid-row--middle fr-mb-2w">
        <div class="fr-col">
            <h2 class="fr-h4 fr-mb-0">Salles disponibles</h2>
        </div>
        <div class="fr-col-auto">
            <button class="fr-btn fr-btn--secondary fr-btn--sm fr-icon-filter-line fr-btn--icon-left"
                    type="button"
                    id="toggle-filters-btn">
                Afficher les filtres
            </button>
        </div>
    </div>

    {# ── Panneau filtres (masqué par défaut) ──────────────────────────────── #}
    <div id="filter-panel"
         style="display:none; border:1px solid #ddd; border-radius:4px;
                padding:1.25rem 1.5rem 1rem; background:#f6f6f6; margin-bottom:1.5rem;">

        <div class="fr-grid-row fr-grid-row--gutters">

            {# Slider capacité #}
            <div class="fr-col-12 fr-col-md-5">
                <p class="fr-text--sm fr-text--bold fr-mb-1w">Capacité minimum</p>
                <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--middle">
                    <div class="fr-col-auto">
                        <span id="cap-label" class="fr-text--sm fr-text--bold" style="min-width:3rem; display:inline-block;">0</span>
                    </div>
                    <div class="fr-col">
                        <input type="range" id="cap-slider" min="0" max="300" step="5" value="0"
                               style="width:100%; accent-color:#000091;"
                               oninput="updateCap(this.value)">
                    </div>
                    <div class="fr-col-auto">
                        <span class="fr-text--sm fr-text--mention-grey">Toutes</span>
                    </div>
                </div>
            </div>

            {# Checkboxes équipements #}
            <div class="fr-col-12 fr-col-md-7">
                <p class="fr-text--sm fr-text--bold fr-mb-1w">Équipements requis</p>
                <div class="fr-grid-row fr-grid-row--gutters">
                    {% for eq in ['Rétroprojecteur','Vidéoconférence','Tableau blanc','Wifi','Système audio','Micro'] %}
                    <div class="fr-col-6 fr-col-md-4">
                        <div class="fr-checkbox-group fr-checkbox-group--sm">
                            <input type="checkbox"
                                   id="eq-{{ loop.index }}"
                                   class="eq-check"
                                   data-eq="{{ eq|lower }}"
                                   onchange="applyFilters()">
                            <label class="fr-label" for="eq-{{ loop.index }}">{{ eq }}</label>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

        </div>

        {# Tags filtres actifs #}
        <ul class="fr-tags-group fr-mt-2w" id="active-tags" style="display:none;"></ul>
        <div id="reset-wrap" style="display:none; margin-top:.75rem;">
            <button type="button" class="fr-btn fr-btn--tertiary fr-btn--sm"
                    onclick="resetFilters()">Réinitialiser tout</button>
        </div>
    </div>

    {# ── Grille des ressources ─────────────────────────────────────────────── #}
    {% if resources is empty %}
        <div class="fr-alert fr-alert--info">
            <p>Aucune salle disponible dans cette catégorie pour le moment.</p>
        </div>
    {% else %}

    <p class="fr-text--sm fr-text--mention-grey fr-mb-2w" id="result-count">
        {{ resources|length }} salle{{ resources|length > 1 ? 's' : '' }} –
        résultats pour le <strong>{{ selectedDate|date('d/m/Y') }}</strong>
    </p>

    <div class="fr-grid-row fr-grid-row--gutters" id="resource-grid">
        {% for resource in resources %}

        {# On normalise les notes pour le filtrage JS #}
        {% set notes_lower = resource.notes ? resource.notes|lower : '' %}

        <div class="fr-col-12 fr-col-md-4 resource-col"
             data-capacity="{{ resource.maxParticipants ?? 0 }}"
             data-notes="{{ notes_lower }}">

            <div class="fr-card fr-card--sm"
                 style="border:1px solid #e5e5e5; border-radius:4px; height:100%; background:#fff;">

                {# Image #}
                <div class="fr-card__header">
                    <div class="fr-card__img" style="height:140px; overflow:hidden;">
                        {% if resource.imageName %}
                            <img src="{{ asset('uploads/resources/' ~ resource.imageName) }}"
                                 alt="{{ resource.name }}"
                                 style="width:100%; height:100%; object-fit:cover;">
                        {% else %}
                            <div style="width:100%; height:100%; background:#eee;
                                        display:flex; align-items:center; justify-content:center;">
                                <span class="fr-icon-building-line" aria-hidden="true"
                                      style="font-size:2.5rem; color:#999;"></span>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="fr-card__body">
                    <div class="fr-card__content">

                        {# Badge disponibilité #}
                        <ul class="fr-tags-group fr-mb-1w">
                            {% if availabilityMap[resource.id] is defined %}
                                {% if availabilityMap[resource.id] %}
                                    <li><p class="fr-badge fr-badge--success fr-badge--sm">Disponible</p></li>
                                {% else %}
                                    <li><p class="fr-badge fr-badge--error fr-badge--sm">Non disponible</p></li>
                                {% endif %}
                            {% endif %}
                            {% if resource.category %}
                                <li><p class="fr-badge fr-badge--sm">{{ resource.category.name }}</p></li>
                            {% endif %}
                        </ul>

                        {# Titre #}
                        <h3 class="fr-card__title" style="font-size:1rem; margin-bottom:.5rem;">
                            <a class="fr-card__link"
                               href="{{ path('app_resource_show', {id: resource.id}) }}">
                                {{ resource.name }}
                            </a>
                        </h3>

                        {# Description courte #}
                        {% if resource.description %}
                            <p class="fr-text--sm fr-text--mention-grey fr-mb-1w">
                                {{ resource.description|length > 80
                                   ? resource.description|slice(0,80) ~ '…'
                                   : resource.description }}
                            </p>
                        {% endif %}

                        {# Capacité #}
                        {% if resource.maxParticipants %}
                            <p class="fr-text--sm fr-mb-1w">
                                Capacité&nbsp;: <strong>{{ resource.maxParticipants }} personnes</strong>
                            </p>
                        {% endif %}

                        {# Localisation #}
                        {% if resource.location %}
                            <p class="fr-text--xs fr-text--mention-grey fr-mb-1w fr-icon-map-pin-2-line">
                                &nbsp;{{ resource.location }}
                            </p>
                        {% endif %}

                        {# Équipements (tags depuis notes) #}
                        {% if resource.notes %}
                        <ul class="fr-tags-group fr-mt-1w">
                            {% for eq in resource.notes|split(',') %}
                                {% if eq|trim %}
                                    <li><p class="fr-tag fr-tag--sm">{{ eq|trim }}</p></li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                        {% endif %}

                    </div>

                    {# Pied de carte #}
                    <div class="fr-card__footer">
                        <ul class="fr-btns-group fr-btns-group--sm fr-btns-group--inline">
                            <li>
                                <a class="fr-btn fr-btn--sm"
                                   href="{{ path('reservation_new', {resource: resource.id, date: selectedDate}) }}">
                                    Réserver ce jour-là
                                </a>
                            </li>
                            <li>
                                <a class="fr-btn fr-btn--secondary fr-btn--sm"
                                   href="{{ path('app_resource_show', {id: resource.id}) }}">
                                    Voir la fiche
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

            </div>
        </div>
        {% endfor %}
    </div>

    <p id="no-results-msg" style="display:none;" class="fr-text--mention-grey fr-mt-3w">
        Aucune salle ne correspond aux filtres sélectionnés.
    </p>

    {% endif %}
</div>

{# ── JavaScript filtres (100% client-side, aucun rechargement) ────────────── #}
<script>
/* ---------- Toggle panneau ---------- */
(function () {
    const btn   = document.getElementById('toggle-filters-btn');
    const panel = document.getElementById('filter-panel');
    if (!btn || !panel) return;

    let open = false;

    btn.addEventListener('click', function (e) {
        e.stopPropagation();
        open = !open;
        panel.style.display = open ? 'block' : 'none';

        if (open) {
            btn.classList.remove('fr-icon-filter-line');
            btn.classList.add('fr-icon-subtract-line');
            btn.innerHTML = ' Masquer les filtres';
        } else {
            btn.classList.remove('fr-icon-subtract-line');
            btn.classList.add('fr-icon-filter-line');
            btn.innerHTML = ' Afficher les filtres';
        }
    });
}());

/* ---------- Slider capacité ---------- */
function updateCap(val) {
    const lbl = document.getElementById('cap-label');
    lbl.textContent = val > 0 ? val + '+' : '0';
    applyFilters();
}

/* ---------- Filtrage principal ---------- */
function applyFilters() {
    const minCap  = parseInt(document.getElementById('cap-slider').value, 10);
    const checked = [...document.querySelectorAll('.eq-check:checked')]
                        .map(cb => cb.dataset.eq);

    const cols = document.querySelectorAll('.resource-col');
    let visible = 0;

    cols.forEach(col => {
        const cap   = parseInt(col.dataset.capacity, 10) || 0;
        const notes = col.dataset.notes || '';
        const capOk = cap >= minCap;
        const eqOk  = checked.length === 0 || checked.every(eq => notes.includes(eq));
        const show  = capOk && eqOk;
        col.style.display = show ? '' : 'none';
        if (show) visible++;
    });

    // Mise à jour compteur
    const countEl = document.getElementById('result-count');
    if (countEl) {
        countEl.querySelector('strong') && null; // pas de double remplacement
    }

    // Message aucun résultat
    const noMsg = document.getElementById('no-results-msg');
    if (noMsg) noMsg.style.display = visible === 0 ? '' : 'none';

    refreshTags(minCap, checked);
}

/* ---------- Tags filtres actifs ---------- */
function refreshTags(minCap, checked) {
    const ul      = document.getElementById('active-tags');
    const resetWr = document.getElementById('reset-wrap');
    ul.innerHTML  = '';

    const labels = [];
    if (minCap > 0) labels.push('≥ ' + minCap + ' pers.');
    checked.forEach(eq => labels.push(eq));

    if (labels.length) {
        labels.forEach(t => {
            const li = document.createElement('li');
            li.innerHTML = `<p class="fr-tag fr-tag--sm">${t}</p>`;
            ul.appendChild(li);
        });
        ul.style.display       = '';
        resetWr.style.display  = '';
    } else {
        ul.style.display       = 'none';
        resetWr.style.display  = 'none';
    }
}

/* ---------- Réinitialiser ---------- */
function resetFilters() {
    document.getElementById('cap-slider').value = 0;
    document.getElementById('cap-label').textContent = '0';
    document.querySelectorAll('.eq-check').forEach(cb => cb.checked = false);
    applyFilters();
}
</script>
{% endblock %}
