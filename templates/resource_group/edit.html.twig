{% extends 'base.html.twig' %}

{% block title %}Modifier l'équipe{% endblock %}

{% block body %}
    <div class="fr-container fr-mt-4w">
        <h1>Modifier l'équipe</h1>

        {{ form_start(form) }}
        {{ form_widget(form) }}
        <button class="fr-btn fr-mt-2w" type="submit">Mettre à jour</button>
        <a href="{{ path('app_resource_group_index') }}" class="fr-btn fr-btn--secondary fr-mt-2w">Annuler</a>
        {{ form_end(form) }}

        <hr class="fr-mt-4w">
        {{ include('resource_group/_delete_form.html.twig', ignore_missing=true) }}
    </div>
{% endblock %}
