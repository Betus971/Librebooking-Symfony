{% extends 'base.html.twig' %}

{% block title %}Équipes & Groupes{% endblock %}

{% block body %}
    <div class="fr-container fr-mt-4w">
        <h1>Gestion des Équipes</h1>
        <p>Créez les groupes qui géreront vos ressources (ex: Logistique, Pédagogie...).</p>

        <a href="{{ path('app_resource_group_new') }}" class="fr-btn fr-mb-2w">Créer une nouvelle équipe</a>

        <div class="fr-table fr-table--bordered">
            <table>
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom de l'équipe</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for group in resource_groups %}
                    <tr>
                        <td>{{ group.id }}</td>
                        <td><strong>{{ group.name }}</strong></td>
                        <td>
                            <a href="{{ path('app_resource_group_edit', {'id': group.id}) }}" class="fr-btn fr-btn--sm fr-btn--secondary">Modifier</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">Aucune équipe n'a été créée pour le moment.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
