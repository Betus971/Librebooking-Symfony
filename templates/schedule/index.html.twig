{% extends 'base.html.twig' %}

{% block title %}Gestion des Plannings{% endblock %}

{% block body %}

    <div class="fr-container fr-my-4w">
        {# --- EN-TÊTE --- #}
        <div class="fr-grid-row fr-grid-row--middle fr-mb-3w">
            <div class="fr-col">
                <h1 class="fr-h2 fr-mb-0">Plannings & Horaires</h1>
                <p class="fr-text--sm fr-text--mention-grey fr-mb-0">Gérez les heures d'ouverture et les grilles de réservation.</p>
            </div>
            <div class="fr-col-auto">
                <a href="{{ path('app_schedule_new') }}" class="fr-btn fr-icon-add-line fr-btn--icon-left">
                    Nouveau planning
                </a>
            </div>
        </div>

        <div class="fr-grid-row fr-grid-row--gutters">
            {% for schedule in schedules %}
                <div class="fr-col-12 fr-col-md-6 fr-col-lg-4">
                    <div class="fr-card fr-enlarge-link">
                        <div class="fr-card__body">
                            <div class="fr-card__content">
                                {# --- Titre --- #}
                                <h3 class="fr-card__title">
                                    <a href="{{ path('app_schedule_edit', {id: schedule.id, tab: 'grid'}) }}">
                                        {{ schedule.name }}
                                    </a>
                                </h3>

                                {# --- Badges de statut --- #}
                                <ul class="fr-tags-group fr-mt-1w">
                                    <li>
                                        {% if schedule.Published %}
                                            <p class="fr-tag fr-tag--sm fr-tag--green-emerald">Publié</p>
                                        {% else %}
                                            <p class="fr-tag fr-tag--sm">Brouillon</p>
                                        {% endif %}
                                    </li>
                                    {% if schedule.layout %}
                                        <li><p class="fr-tag fr-tag--sm fr-tag--blue-ecume">{{ schedule.layout.timezone }}</p></li>
                                    {% endif %}
                                </ul>

                                {# --- Infos Techniques (SANS ICÔNES CSS POUR ÉVITER LE BUG) --- #}
                                <div class="fr-mt-3w">
                                    <p class="fr-text--sm fr-mb-1v">
                                        {# On utilise un emoji, c'est du texte, donc 0 risque de bug CSS #}
                                        📅 Début semaine :
                                        <strong>{{ ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'][schedule.weekdayStart % 7] }}</strong>
                                    </p>

                                    {% set blocks = blocksBySchedule[schedule.id]|default([]) %}
                                    {% set openCount = 0 %}
                                    {% for b in blocks %}{% if b.availabilityCode == 1 %}{% set openCount = openCount + 1 %}{% endif %}{% endfor %}

                                    <p class="fr-text--sm fr-mb-0">
                                        🕒 Grille horaire :
                                        {% if openCount > 0 %}
                                            <strong class="fr-text--success">{{ openCount }} créneaux</strong>
                                        {% else %}
                                            <strong class="fr-text--warning">Vide</strong>
                                        {% endif %}
                                    </p>
                                </div>

                                {# --- Dates de validité --- #}
                                {% if schedule.startDate or schedule.endDate %}
                                    <p class="fr-text--xs fr-mt-2w fr-mb-0 fr-text--mention-grey">
                                        Valide
                                        {% if schedule.startDate %}du {{ schedule.startDate|date('d/m/Y') }}{% endif %}
                                        {% if schedule.endDate %} au {{ schedule.endDate|date('d/m/Y') }}{% endif %}
                                    </p>
                                {% endif %}
                            </div>
                        </div>

                        {# --- Footer Actions --- #}
                        <div class="fr-card__footer">
                            <ul class="fr-btns-group fr-btns-group--inline fr-btns-group--sm">
                                <li>
                                    <a href="{{ path('app_schedule_edit', {id: schedule.id, tab: 'params'}) }}" class="fr-btn fr-btn--secondary fr-btn--sm">
                                        Paramètres
                                    </a>
                                </li>
                                <li>
                                    <a href="{{ path('app_schedule_edit', {id: schedule.id, tab: 'grid'}) }}" class="fr-btn fr-btn--tertiary fr-btn--sm">
                                        Gérer la grille
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="fr-col-12">
                    <div class="fr-alert fr-alert--info">
                        <h3 class="fr-alert__title">Aucun planning</h3>
                        <p>Commencez par créer un planning pour définir vos horaires d'ouverture.</p>
                        <a href="{{ path('app_schedule_new') }}" class="fr-btn fr-btn--secondary fr-mt-2w">Créer un planning</a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
