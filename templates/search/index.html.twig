{% extends 'base.html.twig' %}

{% block title %}{{ 'search.breadcrumb'|trans }} - Librebooking{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto">
    <div class="text-sm breadcrumbs mb-4">
        <ul>
            <li><a href="{{ path('app_home') }}">{{ 'common.home'|trans }}</a></li>
            <li>{{ 'search.breadcrumb'|trans }}</li>
        </ul>
    </div>

    <h1 class="text-3xl font-extrabold mb-1">{{ 'search.title'|trans }}</h1>
    <p class="text-base-content/60 mb-6">{{ 'search.results_for'|trans }} <strong>{{ searched_date|date('d/m/Y') }}</strong></p>

    {% if resources is empty %}
        <div class="alert alert-warning shadow-sm">
            <div>
                <h3 class="font-bold">{{ 'search.empty_title'|trans }}</h3>
                <p class="text-sm">{{ 'search.empty_text'|trans }} <a href="{{ path('app_home') }}" class="link">{{ 'search.back_home'|trans }}</a></p>
            </div>
        </div>
    {% else %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for resource in resources %}
                {% set imgPath = resource.imageName ? asset('uploads/resources/' ~ resource.imageName) : 'https://placehold.co/600x400?text=Salle' %}
                <div class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden">
                    <figure class="h-48"><img src="{{ imgPath }}" alt="{{ resource.name }}" class="w-full h-full object-cover"></figure>
                    <div class="card-body">
                        <h3 class="card-title">
                            <a href="{{ path('app_resource_show', {id: resource.id}) }}" class="hover:text-primary">{{ resource.name }}</a>
                        </h3>
                        <p class="text-sm text-base-content/70">{{ resource.description|default('')|u.truncate(80, '...') }}</p>
                        <div class="flex flex-wrap gap-2">
                            <span class="badge badge-success badge-sm">{{ 'common.available'|trans }}</span>
                            <span class="badge badge-sm">{{ resource.category.name ?? 'search.other'|trans }}</span>
                        </div>
                        <div class="card-actions justify-end mt-2">
                            <a href="{{ path('reservation_new', {'resource': resource.id, 'date': searched_date}) }}" class="btn btn-primary btn-sm">{{ 'search.book_that_day'|trans }}</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
