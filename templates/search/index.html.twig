{% extends 'base.html.twig' %}

{% block title %}Hello SearchController!{% endblock %}

{% block body %}<div class="fr-container fr-my-4w">

    {# Fil d'ariane #}
    <nav role="navigation" class="fr-breadcrumb" aria-label="vous êtes ici :">
        <button class="fr-breadcrumb__button" aria-expanded="false" aria-controls="breadcrumb-1">Voir le fil d’ariane</button>
        <div class="fr-collapse" id="breadcrumb-1">
            <ol class="fr-breadcrumb__list">
                <li><a class="fr-breadcrumb__link" href="{{ path('app_home') }}">Accueil</a></li>
                <li><a class="fr-breadcrumb__link" aria-current="page">Recherche</a></li>
            </ol>
        </div>
    </nav>

    <h1 class="fr-h1 fr-mt-2w">Salles disponibles</h1>
    <p class="fr-text--lead">
        Résultats pour le <strong>{{ searched_date|date('d/m/Y') }}</strong>
    </p>

    {% if resources is empty %}
        <div class="fr-alert fr-alert--warning fr-mb-4w">
            <h3 class="fr-alert__title">Aucune salle trouvée</h3>
            <p>Essayez de chercher une autre catégorie.</p>
            <a href="{{ path('app_home') }}" class="fr-btn fr-btn--secondary fr-mt-2w">Retour à l'accueil</a>
        </div>
    {% else %}

        <div class="fr-grid-row fr-grid-row--gutters">
            {% for resource in resources %}
                {#
                ✅ CORRECTION ICI : On utilise 'uploads/resources/' comme dans ta vue qui marche.
                J'ai gardé le placeholder gris en secours si l'image 'amphi' n'existe pas,
                mais tu peux remettre ton image par défaut si tu préfères.
                #}
                {% set imgPath = resource.imageName ? asset('uploads/resources/' ~ resource.imageName) : 'https://placehold.co/600x400?text=Salle' %}

                <div class="fr-col-12 fr-col-md-6 fr-col-lg-4">
                    <div class="fr-card fr-enlarge-link">

                        {# 1. BODY (Contenu) #}
                        <div class="fr-card__body">
                            <div class="fr-card__content">
                                <h3 class="fr-card__title">
                                    <a href="{{ path('app_resource_show', {id: resource.id}) }}">{{ resource.name }}</a>
                                </h3>
                                <p class="fr-card__desc">
                                    {{ resource.description|default('')|u.truncate(80, '...') }}
                                </p>
                                <div class="fr-card__start">
                                    <ul class="fr-tags-group">
                                        <li><p class="fr-tag fr-tag--sm fr-tag--green-emerald">Disponible</p></li>
                                        <li><p class="fr-tag fr-tag--sm">{{ resource.category.name ?? 'Autre' }}</p></li>
                                    </ul>
                                </div>
                            </div>

                            {# FOOTER (Le bouton SANS icône) #}
                            <div class="fr-card__footer">
                                <a href="{{ path('reservation_new', {'resource': resource.id, 'date': searched_date}) }}"
                                   class="fr-btn fr-btn--secondary">
                                    Réserver ce jour-là
                                </a>
                            </div>
                        </div>

                        {# 2. HEADER (L'image) - Placé après le body comme dans ton modèle #}
                        <div class="fr-card__header">
                            <div class="fr-card__img">
                                <img src="{{ imgPath }}" class="fr-responsive-img" alt="" style="object-fit: cover; height: 200px; width: 100%;">
                            </div>
                        </div>

                    </div>
                </div>
            {% endfor %}
        </div>

    {% endif %}
    </div>
{% endblock %}
