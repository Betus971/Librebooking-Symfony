<form method="post" action="{{ path('app_time_block_delete', {'id': time_block.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce créneau ?');" style="display:inline-block;">
    {# CORRECTION ICI : On utilise le même nom que dans le Controller #}
    <input type="hidden" name="_token" value="{{ csrf_token('delete_timeblock_' ~ time_block.id) }}">

    <button class="fr-btn fr-btn--sm fr-btn--tertiary-no-outline fr-icon-delete-line fr-text--error">
        Supprimer
    </button>
</form>
