{% extends 'base.html.twig' %}

{% block title %}New TimeBlock{% endblock %}

{% block body %}
    <div class="fr-container fr-my-4w">

        {# --- FIL D'ARIANE --- #}
        <nav role="navigation" class="fr-breadcrumb" aria-label="vous êtes ici :">
            <button class="fr-breadcrumb__button" aria-expanded="false" aria-controls="breadcrumb-1">Voir le fil d’ariane</button>
            <div class="fr-collapse" id="breadcrumb-1">
                <ol class="fr-breadcrumb__list">
                    <li><a class="fr-breadcrumb__link" href="{{ path('app_schedule_index') }}">Plannings</a></li>
                    {% if schedule is defined %}
                        <li>
                            <a class="fr-breadcrumb__link" href="{{ path('app_schedule_edit', {id: schedule.id, tab: 'grid'}) }}">
                                {{ schedule.name }}
                            </a>
                        </li>
                    {% endif %}
                    <li><a class="fr-breadcrumb__link" aria-current="page">Gestion des créneaux</a></li>
                </ol>
            </div>
        </nav>

        <div class="fr-grid-row fr-grid-row--middle fr-mb-3w">
            <div class="fr-col">
                <h1 class="fr-h2 fr-mb-0">Générateur de créneaux</h1>
                {% if layout is defined %}
                    <p class="fr-text--sm fr-text--mention-grey">Layout : {{ layout.name }}</p>
                {% endif %}
            </div>
            <div class="fr-col-auto">
                {% if schedule is defined %}
                    <a href="{{ path('app_schedule_edit', {id: schedule.id, tab: 'grid'}) }}" class="fr-btn fr-btn--secondary fr-icon-arrow-left-line fr-btn--icon-left">
                        Retour à la grille
                    </a>
                {% endif %}
            </div>
        </div>

        {{ form_start(form, { attr: { class: 'fr-form', novalidate: 'novalidate' } }) }}

        <div class="fr-grid-row fr-grid-row--gutters">

            {# --- COLONNE GAUCHE : GÉNÉRATION EN MASSE + NETTOYAGE --- #}
            <div class="fr-col-12 fr-col-lg-8">
                <div class="fr-card">
                    <div class="fr-card__header">
                        <h2 class="fr-card__title">✨ Génération automatique</h2>
                        <p class="fr-card__detail">Créez ou nettoyez une série de créneaux sur plusieurs jours.</p>
                    </div>
                    <div class="fr-card__body">
                        <div class="fr-card__content">

                            {# 1. CHOIX DES JOURS #}
                            <div class="fr-form-group">
                                <fieldset class="fr-fieldset">
                                    <legend class="fr-fieldset__legend fr-text--regular fr-font-weight-bold">
                                        Jours concernés
                                    </legend>
                                    <div class="fr-fieldset__content">
                                        <div class="fr-grid-row fr-grid-row--gutters">
                                            {% for child in form.days %}
                                                <div class="fr-col-6 fr-col-md-3">
                                                    <div class="fr-checkbox-group fr-checkbox-group--sm">
                                                        {{ form_widget(child) }}
                                                        {{ form_label(child) }}
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </div>
                                        {% if form.days.vars.errors|length > 0 %}
                                            <div class="fr-alert fr-alert--error fr-alert--sm fr-mt-2w">
                                                {{ form_errors(form.days) }}
                                            </div>
                                        {% endif %}
                                    </div>
                                </fieldset>
                            </div>

                            <hr class="fr-my-2w">

                            {# 2. HORAIRES #}
                            <div class="fr-grid-row fr-grid-row--gutters">
                                <div class="fr-col-12 fr-col-md-4">
                                    {{ form_row(form.startTime) }}
                                </div>
                                <div class="fr-col-12 fr-col-md-4">
                                    {{ form_row(form.endTime) }}
                                </div>
                                <div class="fr-col-12 fr-col-md-4">
                                    {{ form_row(form.slotDuration) }}
                                </div>
                            </div>

                            {# 3. INFO COMPLÉMENTAIRE #}
                            <div class="fr-grid-row fr-grid-row--gutters">
                                <div class="fr-col-12 fr-col-md-6">
                                    {{ form_row(form.availabilityCode) }}
                                </div>
                                <div class="fr-col-12 fr-col-md-6">
                                    {{ form_row(form.label) }}
                                    {{ form_row(form.endLabel) }}
                                </div>
                            </div>

                            {# BARRE D'ACTIONS (Vider à gauche, Générer à droite) #}
                            <div class="fr-mt-4w">
                                <ul class="fr-btns-group fr-btns-group--inline fr-btns-group--right fr-btns-group--icon-left">
                                    <li>
                                        {{ form_widget(form.clear, {
                                            label: 'Vider la sélection',
                                            attr: {
                                                class: 'fr-btn fr-btn--secondary fr-icon-delete-line fr-text--error',
                                                onclick: "return confirm('Attention ! Cela va supprimer TOUS les créneaux des jours cochés ci-dessus. Continuer ?');"
                                            }
                                        }) }}
                                    </li>
                                    <li>
                                        {{ form_widget(form.generate, { attr: { class: 'fr-btn fr-icon-refresh-line' } }) }}
                                    </li>
                                </ul>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            {# --- COLONNE DROITE : AJOUT MANUEL SEULEMENT --- #}
            <div class="fr-col-12 fr-col-lg-4">

                <div class="fr-card">
                    <div class="fr-card__header">
                        <h2 class="fr-card__title fr-text--md">➕ Ajout manuel unique</h2>
                    </div>
                    <div class="fr-card__body">
                        <div class="fr-card__content">
                            <p class="fr-text--xs fr-mb-2w">
                                Ajoute un seul créneau en utilisant les <strong>horaires saisis à gauche</strong>.
                            </p>

                            {{ form_row(form.dayOfWeek) }}

                            <div class="fr-mt-2w">
                                {{ form_widget(form.save, { attr: { class: 'fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-save-line fr-sys-width-full' } }) }}
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="fr-sr-only">
            {{ form_rest(form) }}
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}
